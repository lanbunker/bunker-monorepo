---
import Layout from "../layouts/Layout.astro";
import { getEntry } from "astro:content";

const entry = await getEntry("about", "about");
---

<Layout title="ABOUT//LAN_BUNKER" active="about">
  <h2 class="text-[14px] mt-8 mb-4 text-accent font-normal font-mono">
    {">"}
    {entry?.data.title ?? "README.txt"}
  </h2>

  <pre
    class="text-[12px] leading-[1.8] text-[#ccc] whitespace-pre-wrap wrap-break-word">{entry?.body?.trim()}</pre>
</Layout>
