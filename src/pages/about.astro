---
import Layout from "../layouts/Layout.astro";
import { getEntry } from "astro:content";

const entry = await getEntry("about", "about");
---

<Layout title="LAN BUNKER // ABOUT" active="about">
  <h2 class="text-[14px] mt-8 mb-4 text-accent font-normal font-mono">
    {">"} {entry?.data.title ?? "README.txt"}
  </h2>

  <pre
    class="text-[12px] leading-[1.8] text-[#ccc] whitespace-pre-wrap wrap-break-word"
    >{entry?.body?.trim()}</pre>

  <pre class="text-border text-[10px] mt-8">{`     ___________
    |  _______  |
    | |       | |
    | | LAN   | |    ENTER THE BUNKER
    | | BUNKER| |    GRAB A CONTROLLER
    | |_______| |    NO EXCUSES
    |___________|
     _|_______|_
    / ========= \\
   / =========== \\
  /___|_________|___\\`}</pre>
</Layout>
