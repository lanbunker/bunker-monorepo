---
// MOCK: UI preview only. Data is hardcoded, there is no backend and no login yet.
import Badge from "../../components/ui/Badge.astro"
import Button from "../../components/ui/Button.astro"
import Glyph from "../../components/ui/Glyph.astro"
import Panel from "../../components/ui/Panel.astro"
import Prompt from "../../components/ui/Prompt.astro"
import { players, totalKarma } from "../../data/mock-players"
import Layout from "../../layouts/Layout.astro"
import { rankFor } from "../../lib/rank"

const roster = players
  .map(p => ({ player: p, karma: totalKarma(p), rank: rankFor(totalKarma(p)).current }))
  .sort((a, b) => b.karma - a.karma)
---

<Layout title="PLAYERS//LAN_BUNKER" active="scores" noindex>
  <Prompt command="ls /players" comment={`${roster.length} enlisted · mock data`} />

  <Panel>
    <table class="w-full border-collapse text-xs">
      <thead>
        <tr class="text-left text-2xs tracking-wider text-dim">
          <th class="w-[8%] pb-2 font-normal">#</th>
          <th class="w-[47%] pb-2 font-normal">player</th>
          <th class="w-[25%] pb-2 font-normal">rank</th>
          <th class="w-[20%] pb-2 text-right font-normal">karma</th>
        </tr>
      </thead>
      <tbody>
        {
          roster.map(({ player, karma, rank }, i) => (
            <tr class="border-t border-faint hover:bg-faint/40">
              <td class="py-2 text-mute tabular-nums">{String(i + 1).padStart(2, "0")}</td>
              <td class="py-2">
                <a
                  href={`/players/${player.handle}`}
                  class="inline-flex items-center gap-2 no-underline text-bright hover:text-accent"
                >
                  <Glyph glyph={player.glyph} size="1.1em" />
                  {player.handle}
                </a>
              </td>
              <td class="py-2 text-dim">[{rank.name}]</td>
              <td class="py-2 text-right text-accent tabular-nums">{karma.toLocaleString("en-US")}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </Panel>

  <Prompt command="cat /players/glyphs" comment="the same mark at every size" />

  <Panel>
    <div class="flex flex-wrap items-end gap-6">
      {
        players.map(p => (
          <div class="flex flex-col items-center gap-2">
            <Glyph glyph={p.glyph} size="4rem" framed />
            <Glyph glyph={p.glyph} size="1.5rem" />
            <span class="text-xs text-ink">
              <Glyph glyph={p.glyph} /> {p.handle}
            </span>
          </div>
        ))
      }
    </div>
  </Panel>

  <div class="mt-6 flex flex-wrap items-center gap-3">
    <Button href="/players/login" variant="ghost">LOGIN</Button>
    <Badge tone="warn">preview</Badge>
    <span class="text-2xs text-mute">hidden page. not linked from the nav.</span>
  </div>
</Layout>
