---
import TournamentCard from "../components/TournamentCard.astro"
import Prompt from "../components/ui/Prompt.astro"
import { tournaments } from "../data/tournaments"
import Layout from "../layouts/Layout.astro"

const open = tournaments.filter(t => t.status === "OPEN")
const closed = tournaments.filter(t => t.status === "CLOSED")
---

<Layout title="TOURNAMENTS//LAN_BUNKER" active="tournaments">
  <Prompt command="cat ./tournaments/open" comment="subscribe" />

  {
    open.length > 0 ? (
      <div class="flex flex-col gap-6">
        {open.map(t => (
          <TournamentCard tournament={t} />
        ))}
      </div>
    ) : (
      <p class="text-xs text-dim">no open tournaments.</p>
    )
  }

  {
    closed.length > 0 && (
      <>
        <Prompt command="cat ./tournaments/archive" comment="hall of fame" />
        <div class="flex flex-col gap-6">
          {closed.map(t => (
            <TournamentCard tournament={t} />
          ))}
        </div>
      </>
    )
  }
</Layout>
