---
import Layout from "../layouts/Layout.astro";

type Tournament = {
  id: string;
  name: string;
  date: string; // e.g. "26/02/2026"
  format: string;
  slots: string;
  winner?: string;
  winnerImage?: string;
  formLink?: string;
  openUntil?: string; // UTC ISO datetime e.g. "2026-05-10T20:00:00Z"
  status: "OPEN" | "CLOSED";
};

const tournaments: Tournament[] = [
  {
    id: "t1",
    name: "CALL OF DUTY BO2: GUN GAME 1V1",
    date: "26/02/2026",
    format: "1v1 DIRECT ELIMINATION",
    slots: "20",
    winner: "MARINO",
    winnerImage: "/images/winners/winner-cod-feb26.png",
    status: "CLOSED",
  },
];
---

<Layout title="LAN BUNKER // TOURNAMENTS" active="tournaments">
  <h2 class="text-[14px] mt-8 mb-4 text-accent font-normal font-mono">
    {">"} TOURNAMENTS <span class="text-dim">// subscribe</span>
  </h2>

  <div class="flex flex-col gap-3">
    {
      tournaments.map((t) => (
        <div class="border border-border p-4">
          {/* Title */}
          <div class="text-white text-[15px]">{t.name}</div>

          {/* Status badge */}
          <div class="mt-2">
            <span
              class:list={[
                "text-[11px] px-2 py-0.5 font-bold",
                t.status === "OPEN"
                  ? "bg-accent text-black"
                  : "bg-[#666] text-black",
              ]}
            >
              {t.status === "OPEN"
                ? "REGISTRATION OPEN"
                : "REGISTRATION CLOSED"}
            </span>
          </div>

          {/* Info */}
          <div class="mt-3 text-[12px] text-dim tracking-widest leading-loose">
            <div>
              FORMAT: <span class="text-[#ccc]">{t.format}</span>
            </div>
            <div>
              DATE: <span class="text-[#ccc]">{t.date}</span>
            </div>
            <div>
              TOT_PLAYERS: <span class="text-[#ccc]">{t.slots}</span>
            </div>
          </div>

          {/* OPEN: form link + deadline */}
          {t.status === "OPEN" && t.openUntil && (
            <div class="mt-3">
              <div
                class="text-[12px] text-dim tracking-widest mb-2 open-until-wrap"
                data-deadline={t.openUntil}
              >
                OPEN_UNTIL: <span class="open-until-value text-[#ccc]" />
              </div>
              {t.formLink && (
                <a
                  href={t.formLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="register-btn inline-block bg-accent text-black px-5 py-2 text-[12px] font-bold font-mono tracking-[0.05em] no-underline hover:brightness-120 cursor-pointer"
                  data-deadline={t.openUntil}
                >
                  [REGISTER]
                </a>
              )}
            </div>
          )}

          {/* Winner section */}
          {t.status === "CLOSED" && t.winner && (
            <div class="mt-5 pt-4 border-t border-faint">
              <div class="flex gap-5 items-center flex-wrap">
                {t.winnerImage && (
                  <div class="winner-card">
                    <div class="winner-img-wrap">
                      <img
                        src={t.winnerImage}
                        alt={`Winner: ${t.winner}`}
                        loading="lazy"
                        class="w-full h-full object-cover block"
                      />
                      <div class="winner-scanlines" />
                    </div>
                  </div>
                )}
                <div>
                  <div class="text-[10px] text-dim tracking-[0.2em]">
                    WINNER
                  </div>
                  <div class="text-[22px] text-accent tracking-widest leading-tight mt-1">
                    {t.winner}
                  </div>
                  <div class="mt-1 text-[10px] text-dim tracking-[0.15em]">
                    STATUS: <span class="text-accent">CHAMPION</span>
                  </div>
                </div>
              </div>
            </div>
          )}

          {t.status === "CLOSED" && !t.winner && (
            <div class="mt-3 text-[11px] text-[#666]">NO WINNER RECORDED.</div>
          )}
        </div>
      ))
    }
  </div>
</Layout>

<style>
  .winner-card {
    width: 120px;
    height: 120px;
    flex-shrink: 0;
    background: #111;
    border: 2px solid #00ff41;
    box-shadow: 3px 3px 0 #000;
  }

  .winner-img-wrap {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .winner-img-wrap img {
    filter: saturate(0.6) contrast(1.1) brightness(0.95);
  }

  .winner-scanlines {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 1px,
      rgba(0, 0, 0, 0.15) 1px,
      rgba(0, 0, 0, 0.15) 2px
    );
  }
</style>

<script>
  const initDeadlines = () => {
    const now = Date.now();
    const tzOffset = new Date().getTimezoneOffset();
    const tzHours = -Math.floor(tzOffset / 60);
    const tzMins = Math.abs(tzOffset % 60);
    const tzLabel =
      "UTC" +
      (tzHours >= 0 ? "+" : "") +
      tzHours +
      (tzMins > 0 ? ":" + String(tzMins).padStart(2, "0") : "");

    document
      .querySelectorAll<HTMLElement>(".open-until-wrap")
      .forEach((wrap) => {
        const deadline = wrap.dataset.deadline;
        if (!deadline) return;

        const dt = new Date(deadline);
        const expired = now >= dt.getTime();

        const day = String(dt.getDate()).padStart(2, "0");
        const month = String(dt.getMonth() + 1).padStart(2, "0");
        const year = dt.getFullYear();
        const hours = String(dt.getHours()).padStart(2, "0");
        const mins = String(dt.getMinutes()).padStart(2, "0");
        const formatted = `${day}/${month}/${year} ${hours}:${mins} ${tzLabel}`;

        const valueEl = wrap.querySelector(".open-until-value");
        if (valueEl) {
          if (expired) {
            valueEl.innerHTML = `<span style="color:#666;text-decoration:line-through">${formatted}</span> <span style="color:#ff4444">// TIMED OUT</span>`;
          } else {
            valueEl.textContent = formatted;
          }
        }

        const btn =
          wrap.parentElement?.querySelector<HTMLAnchorElement>(".register-btn");
        if (btn && expired) {
          btn.removeAttribute("href");
          btn.style.opacity = "0.3";
          btn.style.pointerEvents = "none";
          btn.style.cursor = "not-allowed";
          btn.textContent = "[REGISTRATION CLOSED]";
        }
      });
  };

  initDeadlines();
</script>
