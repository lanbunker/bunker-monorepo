---
import { Image, getImage } from "astro:assets"
import Prompt from "../components/ui/Prompt.astro"
import Layout from "../layouts/Layout.astro"

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/gallery/*.webp",
  { eager: true },
)

const gallery = await Promise.all(
  Object.entries(images).map(async ([path, mod]) => {
    const full = await getImage({
      src: mod.default,
      format: "webp",
      quality: 85,
    })
    return {
      src: mod.default,
      fullSrc: full.src,
      fullWidth: mod.default.width,
      fullHeight: mod.default.height,
      name:
        path
          .split("/")
          .pop()
          ?.replace(/\.[^.]+$/, "") ?? "",
    }
  }),
).then(items => items.sort((a, b) => a.name.localeCompare(b.name)))
---

<Layout title="MEDIA//LAN_BUNKER" active="media">
  <Prompt command="ls ./media/*.webp" comment={`${gallery.length} files`} />

    {
      gallery.length === 0 ? (
        <p class="text-xs text-dim">no media available.</p>
      ) : (
        <div
          id="gallery"
          class="columns-1 gap-3 min-[40rem]:columns-2 min-[50rem]:columns-3"
        >
          {gallery.map((img) => (
            <a
              href={img.fullSrc}
              data-pswp-width={img.fullWidth}
              data-pswp-height={img.fullHeight}
              class="mb-3 break-inside-avoid block"
            >
              <Image
                src={img.src}
                alt={img.name}
                width={800}
                format="webp"
                quality={80}
                class="block h-auto w-full cursor-pointer border border-border hover:border-accent"
                loading="lazy"
                decoding="async"
              />
            </a>
          ))}
        </div>
      )
    }
  <div class="mt-6 text-2xs tracking-wider text-mute">── EOF ──</div>

  <style is:global>
    /* PhotoSwipe above scanlines (z-50) */
    .pswp {
      z-index: 60 !important;
    }

    .pswp__bg {
      background: rgba(0, 0, 0, 0.95) !important;
    }

    /* Hide all default icons */
    .pswp__icn {
      display: none !important;
    }

    /* Shared button style */
    .pswp__button {
      background: none !important;
      box-shadow: none !important;
      border: 1px solid var(--color-border) !important;
      border-radius: 0 !important;
      opacity: 1 !important;
      width: auto !important;
      height: auto !important;
      padding: 0.375rem 0.625rem !important;
      font-family: var(--font-mono) !important;
      color: var(--color-dim) !important;
    }

    .pswp__button:hover {
      border-color: var(--color-accent) !important;
      color: var(--color-accent) !important;
    }

    /* Arrows */
    .pswp__button--arrow--prev::after {
      content: "[<]";
      font-size: 14px;
      letter-spacing: 0.1em;
    }

    .pswp__button--arrow--next::after {
      content: "[>]";
      font-size: 14px;
      letter-spacing: 0.1em;
    }

    /* Close */
    .pswp__button--close::after {
      content: "[X]";
      font-size: 14px;
      letter-spacing: 0.1em;
    }

    /* Hide zoom button */
    .pswp__button--zoom {
      display: none !important;
    }

    /* Counter */
    .pswp__counter {
      font-family: var(--font-mono) !important;
      color: var(--color-dim) !important;
      font-size: 12px !important;
      letter-spacing: 0.1em !important;
      opacity: 1 !important;
    }

    /* Preloader */
    .pswp__preloader {
      display: none !important;
    }

    /* Image border */
    .pswp__img {
      border: 1px solid var(--color-border) !important;
    }

    /* Top bar */
    .pswp__top-bar {
      background: none !important;
    }
  </style>

  <script>
    import PhotoSwipeLightbox from "photoswipe/lightbox";
    import "photoswipe/style.css";

    const lightbox = new PhotoSwipeLightbox({
      gallery: "#gallery",
      children: "a",
      pswpModule: () => import("photoswipe"),
      showHideAnimationType: "none",
      showAnimationDuration: 0,
      hideAnimationDuration: 0,
      zoomAnimationDuration: 0,
    });

    lightbox.init();
  </script>
</Layout>
