---
import Layout from "../layouts/Layout.astro";
---

<Layout title="SHOP//LAN_BUNKER" active="shop">
  <h2 class="text-[14px] mt-8 mb-4 text-accent font-normal font-mono">
    {">"} SHOP <span class="text-dim">// MERCHANDISE</span>
  </h2>

  <div class="border border-border p-8 text-center">
    <p class="text-dim text-[12px] tracking-[0.2em]">// COMING SOON</p>
    <p class="text-[#555] text-[11px] mt-3">
      SHOP IS CURRENTLY UNDER CONSTRUCTION. STAY TUNED FOR OFFICIAL LAN BUNKER
      MERCHANDISE
    </p>
  </div>
</Layout>
