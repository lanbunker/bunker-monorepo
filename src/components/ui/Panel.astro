---
type Tone = "default" | "accent" | "warn" | "muted"

interface Props {
  tone?: Tone
  class?: string
}

const { tone = "default", class: className } = Astro.props

const borderClass: Record<Tone, string> = {
  default: "border-border",
  accent: "border-accent",
  warn: "border-warn",
  muted: "border-faint",
}

// A conditional slot still counts as present, so test the rendered output instead.
const media = Astro.slots.has("media") ? await Astro.slots.render("media") : ""
const hasMedia = media.trim().length > 0
---

<div class:list={["border bg-panel", borderClass[tone], className]}>
  {
    hasMedia && (
      <div class="border-b border-faint">
        <Fragment set:html={media} />
      </div>
    )
  }
  <div class="p-4 max-[30rem]:p-3">
    <slot />
  </div>
</div>
