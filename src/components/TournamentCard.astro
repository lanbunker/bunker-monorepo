---
import { Image } from "astro:assets"
import { isRegistrationOpen } from "../data/tournaments"
import type { Tournament } from "../data/tournaments"
import { formatDate, formatEurDate } from "../lib/dates"
import Badge from "./ui/Badge.astro"
import Button from "./ui/Button.astro"
import Countdown from "./ui/Countdown.astro"
import Kv from "./ui/Kv.astro"
import Panel from "./ui/Panel.astro"

interface Props {
  tournament: Tournament
}

const { tournament: t } = Astro.props
const isOpen = t.status === "OPEN"
const canRegister = isRegistrationOpen(t)
const badgeLabels = { concluded: "CONCLUDED", open: "REGISTRATION OPEN", closed: "REGISTRATION CLOSED" }
const badgeLabel = badgeLabels[!isOpen ? "concluded" : canRegister ? "open" : "closed"]
---

<Panel tone={canRegister ? "accent" : "default"}>
  <div class="flex flex-wrap items-start justify-between gap-2">
    <h3 class="m-0 text-sm tracking-wide text-bright">{t.game}: {t.name}</h3>
    <Badge tone={canRegister ? "accent" : "muted"} filled={canRegister}>
      {badgeLabel}
    </Badge>
  </div>
  {t.description && <p class="mt-1 text-xs text-dim">{t.description}</p>}

  <div class="mt-3 flex flex-col gap-1">
    <Kv label="Format">{t.format}</Kv>
    <Kv label="Date" tone={canRegister ? "accent" : "default"}>{formatEurDate(t.date)}</Kv>
    {t.participants !== undefined && <Kv label="Participants">{t.participants}</Kv>}
    {
      isOpen && t.openUntil && (
        <Kv label="Open until">
          <span class="open-until" data-deadline={t.openUntil}>
            {formatDate(new Date(t.openUntil))}
          </span>
        </Kv>
      )
    }
  </div>

  {
    canRegister && (t.formLink || t.openUntil) && (
      <div class="registration mt-4 flex flex-wrap items-center gap-4" data-deadline={t.openUntil}>
        {t.formLink && (
          <Button href={t.formLink} external class="register-btn">
            REGISTER
          </Button>
        )}
        {t.openUntil && <Countdown deadline={t.openUntil} />}
      </div>
    )
  }

  {
    !isOpen && t.winner && (
      <div class="mt-5 flex flex-wrap items-center gap-5 border-t border-faint pt-4">
        {t.winnerImage && (
          <div class="winner-frame shrink-0">
            <Image
              src={t.winnerImage}
              alt={`Winner: ${t.winner}`}
              width={240}
              format="webp"
              quality={80}
              loading="lazy"
              class="block h-full w-full object-cover"
            />
            <div class="scanlines absolute inset-0 pointer-events-none" />
          </div>
        )}
        <div>
          <div class="text-2xs tracking-wider text-dim">winner</div>
          <div class="mt-1 text-[1.375rem] leading-tight tracking-wider text-accent">{t.winner}</div>
          <div class="mt-1 text-2xs tracking-wider text-dim">
            rank: <span class="text-accent">champion</span>
          </div>
        </div>
      </div>
    )
  }

  {!isOpen && !t.winner && <p class="mt-3 text-2xs text-mute">no winner recorded.</p>}
</Panel>

<style>
  .winner-frame {
    position: relative;
    width: 7.5rem;
    height: 7.5rem;
    overflow: hidden;
    background: var(--color-faint);
    border: 2px solid var(--color-accent);
    box-shadow: 0.1875rem 0.1875rem 0 #000;
  }

  .winner-frame img {
    filter: saturate(0.6) contrast(1.1) brightness(0.95);
  }
</style>

<script>
  import { formatDate } from "../lib/dates"

  const pad2 = (n: number) => String(n).padStart(2, "0")

  const tzLabel = (dt: Date) => {
    const offset = -dt.getTimezoneOffset()
    const sign = offset >= 0 ? "+" : "-"
    const hours = Math.floor(Math.abs(offset) / 60)
    const mins = Math.abs(offset) % 60
    return `UTC${sign}${hours}${mins > 0 ? ":" + pad2(mins) : ""}`
  }

  const now = Date.now()

  for (const el of document.querySelectorAll<HTMLElement>(".open-until")) {
    const deadline = el.dataset.deadline
    if (!deadline) continue
    const dt = new Date(deadline)
    const label = `${formatDate(dt)} ${pad2(dt.getHours())}:${pad2(dt.getMinutes())} ${tzLabel(dt)}`
    if (now >= dt.getTime()) {
      el.innerHTML = `<s class="text-mute">${label}</s> <span class="text-alert">// timed out</span>`
    } else {
      el.textContent = label
    }
  }

  for (const wrap of document.querySelectorAll<HTMLElement>(".registration")) {
    const deadline = wrap.dataset.deadline
    const btn = wrap.querySelector<HTMLAnchorElement>(".register-btn")
    if (!deadline || !btn || now < new Date(deadline).getTime()) continue
    btn.removeAttribute("href")
    btn.classList.add("pointer-events-none", "opacity-30")
    btn.setAttribute("aria-disabled", "true")
    const label = btn.querySelector(".btn-label")
    if (label) label.textContent = "REGISTRATION CLOSED"
  }
</script>
