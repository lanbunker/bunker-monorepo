---
import "../styles/global.css";

interface Props {
  title?: string;
  active:
    | "home"
    | "scores"
    | "events"
    | "tournaments"
    | "media"
    | "shop"
    | "about";
}

const { title = "LAN BUNKER", active } = Astro.props;

const nav = [
  { key: "home", label: "[HOME]", href: "/" },
  { key: "events", label: "[EVENTS]", href: "/events" },
  { key: "tournaments", label: "[TOURNAMENTS]", href: "/tournaments" },
  { key: "scores", label: "[SCORES]", href: "/scores" },
  { key: "media", label: "[MEDIA]", href: "/media" },
  { key: "shop", label: "[SHOP]", href: "/shop" },
  { key: "about", label: "[ABOUT]", href: "/about" },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="LAN BUNKER - recurring local multiplayer event blending music and gaming."
    />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body
    class="bg-black text-[#ccc] font-mono min-h-screen relative text-[14px]"
  >
    <!-- Scanline overlay -->
    <div
      class="fixed inset-0 pointer-events-none z-50"
      style="background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(255,255,255,0.007) 2px, rgba(255,255,255,0.007) 4px);"
    >
    </div>

    <div
      class="max-w-[960px] mx-auto px-7 py-6 max-[480px]:px-3.5 max-[480px]:py-4"
    >
      <!-- Header -->
      <header
        class="flex justify-between items-center pb-2.5 border-b-2 border-white text-[11px]"
      >
        <a
          href="/"
          class="text-white no-underline tracking-[0.2em] text-[15px]"
        >
          > LAN_BUNKER
        </a>
        <span id="clock" class="text-[#666] tabular-nums text-[12px]"></span>
      </header>

      <!-- Nav -->
      <nav
        class="border-b-2 border-white py-3.5 flex gap-1 flex-wrap text-[14px] max-[480px]:gap-0 max-[480px]:text-[12px]"
      >
        {
          nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                "font-mono text-[14px] max-[480px]:text-[12px] cursor-pointer px-2.5 py-1.5 max-[480px]:px-1.5 tracking-[0.05em] no-underline transition-colors duration-100",
                active === item.key
                  ? "bg-white text-black font-bold"
                  : "text-[#999] hover:text-accent",
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <!-- Content -->
      <main>
        <slot />
      </main>

      <!-- Footer -->
      <footer
        class="mt-12 pt-4 border-t border-border text-[10px] text-[#666] flex justify-between flex-wrap gap-2 pb-8 tracking-[0.05em]"
      >
        <span>&copy; LAN BUNKER {new Date().getFullYear()}</span>
      </footer>
    </div>

    <script>
      const updateClock = () => {
        const el = document.getElementById("clock");
        if (el) {
          el.textContent = new Date().toLocaleTimeString("en-GB");
        }
      };
      updateClock();
      setInterval(updateClock, 1000);
    </script>
  </body>
</html>
