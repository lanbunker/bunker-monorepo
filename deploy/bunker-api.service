[Unit]
Description=LAN BUNKER API
After=network-online.target
Wants=network-online.target
# A crash loop never gives up, so the API comes back when the cause goes away.
StartLimitIntervalSec=0

[Service]
User=bunker
Group=bunker
EnvironmentFile=/etc/bunker/api.env
WorkingDirectory=/var/lib/bunker
ExecStart=/usr/local/bin/bunker-api
Restart=always
RestartSec=5
UMask=0077
# The container has 512 MB. The kernel stops the API before the API starves
# cloudflared and sshd.
MemoryMax=384M

# Only options that need no mount namespace. An unprivileged LXC refuses
# ProtectSystem, PrivateTmp and the Protect* family, and the unit would loop.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
