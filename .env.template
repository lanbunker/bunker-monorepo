# Copy this file to `.env`. The API reads it at startup, the sqlx macros read it
# at compile time, and the sqlx CLI reads it too, so none of them can disagree
# about the database.
APP_ENV=local
PORT=3000
# 127.0.0.1 by default. Set 0.0.0.0 when cabinets on the LAN must reach the API.
# BIND_ADDRESS=127.0.0.1

# A path relative to the repository root. `mode=rwc` creates the file.
DATABASE_URL=sqlite://.dev/bunker.db?mode=rwc
DB_MAX_CONNECTIONS=8

# At least 32 characters. Required when APP_ENV=prod. Local and test fall back to
# a development secret.
# JWT_SECRET=

# This replaces the log filter that APP_ENV selects.
# RUST_LOG=bunker_api=debug,tower_http=debug,info
