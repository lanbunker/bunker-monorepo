# The cabinet on a desktop. `make cabd-dev` exports these before it runs the
# binary. Paths are relative to the repository root.
CABD_GAMES=crates/bunker-cabd/dev/games.toml
CABD_ROM_DIR=.dev/roms
CABD_LAUNCHER="crates/bunker-cabd/dev/launcher-fake.sh {rom} {hi}"
CABD_HISCORE_DIR=.dev/hiscore
CABD_TEMPLATE_DIR=crates/bunker-cabd/dev/templates
CABD_IDLE_SECONDS=60
CABD_ORIENTATION=landscape
CABD_OVERSCAN_PERCENT=0
CABD_WINDOW=960x720
RUST_LOG=debug
