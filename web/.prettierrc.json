{
    "plugins": ["prettier-plugin-astro"],
    "semi": false,
    "singleQuote": false,
    "trailingComma": "all",
    "printWidth": 90,
    "tabWidth": 4,
    "overrides": [
        {
            "files": "*.astro",
            "options": {
                "parser": "astro",
                "tabWidth": 2
            }
        }
    ],
    "arrowParens": "avoid"
}
