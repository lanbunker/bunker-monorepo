---
import { LiveBracket } from "../../../components/LiveBracket"
import Layout from "../../../layouts/Layout.astro"
import { call, dataOf, failureOf, isMissing } from "../../../lib/api"

const id = Astro.params.id ?? ""
const result = await call(client =>
  client.GET("/api/tournaments/{id}", { params: { path: { id } } }),
)
const failure = failureOf(result)
if (failure && isMissing(failure)) return Astro.rewrite("/404")

const detail = dataOf(result)
// A live screen must never show a stale bracket.
Astro.response.headers.set("Cache-Control", "no-store")
---

<Layout title={`${detail?.tournament.name ?? "kiosk"}//LIVE`} bare noindex>
  <div class="mx-auto w-full max-w-[90rem] px-6">
    {detail ? (
      <LiveBracket
        client:load
        initial={detail}
        source={`/tournaments/${id}/detail.json`}
      />
    ) : (
      <p class="text-base text-alert">the tournament database is unreachable.</p>
    )}
  </div>
</Layout>
