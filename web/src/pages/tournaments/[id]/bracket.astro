---
import { BracketView } from "../../../components/BracketView"
import Alert from "../../../components/ui/Alert.astro"
import Badge from "../../../components/ui/Badge.astro"
import Button from "../../../components/ui/Button.astro"
import Prompt from "../../../components/ui/Prompt.astro"
import Layout from "../../../layouts/Layout.astro"
import { call, dataOf, failureOf, isMissing } from "../../../lib/api"
import { statusBadge } from "../../../lib/tournaments"

const id = Astro.params.id ?? ""
const result = await call(client =>
  client.GET("/api/tournaments/{id}", { params: { path: { id } } }),
)
const failure = failureOf(result)
if (failure && isMissing(failure)) return Astro.rewrite("/404")

const detail = dataOf(result)
if (detail && !detail.bracket) return Astro.rewrite("/404")
const t = detail?.tournament
const badge = t ? statusBadge(t) : undefined
---

<Layout title={`${t?.name ?? "bracket"}//LAN_BUNKER`} active="tournaments">
  <Prompt heading="p" command={`cat ./tournaments/${id.slice(0, 8)}/bracket`} />

  {detail && detail.bracket && t && badge ? (
    <>
      <div class="mb-4 flex flex-wrap items-baseline justify-between gap-3">
        <div>
          <div class="text-2xs tracking-wider text-dim">{t.game}</div>
          <h1 class="m-0 text-base tracking-wider text-bright">{t.name}</h1>
          <div class="mt-1 text-xs text-dim">{t.mode}</div>
        </div>
        <Badge tone={badge.tone} filled={badge.filled}>
          {badge.label}
        </Badge>
      </div>
      <BracketView bracket={detail.bracket} entrants={detail.entrants} />
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="/tournaments" variant="ghost" size="sm">
          ← TOURNAMENTS
        </Button>
        {t.status === "live" && (
          <Button href={`/tournaments/${id}/kiosk`} variant="ghost" size="sm" external>
            KIOSK VIEW
          </Button>
        )}
      </div>
    </>
  ) : (
    <Alert message="The tournament database is unreachable." />
  )}
</Layout>
