---
import { actions } from "astro:actions"
import Alert from "../../../components/ui/Alert.astro"
import Badge from "../../../components/ui/Badge.astro"
import Button from "../../../components/ui/Button.astro"
import Countdown from "../../../components/ui/Countdown.astro"
import Glyph from "../../../components/ui/Glyph.astro"
import Kv from "../../../components/ui/Kv.astro"
import Panel from "../../../components/ui/Panel.astro"
import Prompt from "../../../components/ui/Prompt.astro"
import Layout from "../../../layouts/Layout.astro"
import { call, dataOf, failureOf, isMissing } from "../../../lib/api"
import { formatIsoDay } from "../../../lib/dates"
import { skillLevel } from "../../../lib/schemas"
import { sessionOf } from "../../../lib/session"
import {
  SKILL_LEVELS,
  UNRATED_SKILL,
  isRegistrationOpen,
  statusBadge,
} from "../../../lib/tournaments"

const id = Astro.params.id ?? ""
const session = sessionOf(Astro.locals)
if (!session) {
  return Astro.redirect(`/login?next=${encodeURIComponent(`/tournaments/${id}/apply`)}`)
}

// The list page shows the notice, so a refresh here never applies twice.
const applied = Astro.getActionResult(actions.applyToTournament)
if (applied?.data) return Astro.redirect("/tournaments?done=applied")

const result = await call(client =>
  client.GET("/api/tournaments/{id}", { params: { path: { id } } }),
)
const failure = failureOf(result)
if (failure && isMissing(failure)) return Astro.rewrite("/404")

const detail = dataOf(result)
const t = detail?.tournament
const open = t ? isRegistrationOpen(t) : false
const badge = t ? statusBadge(t, open) : undefined
// A level changes through retire and apply, so an entrant has nothing to do here.
if (detail?.entrants.some(e => e.player?.id === session.player.id)) {
  return Astro.redirect("/tournaments?done=registered")
}
// A form the API refused comes back with the level that was picked.
const level = skillLevel.safeParse(Astro.locals.submitted.skill).data ?? UNRATED_SKILL
---

<Layout title={`APPLY//${t?.name ?? "tournament"}`} active="tournaments" noindex>
  <Prompt
    heading="p"
    command={`./apply --tournament ${id.slice(0, 8)}`}
    comment="an honest level makes a fun bracket"
  />

  {!detail || !t || !badge ? (
    <Alert message="The tournament database is unreachable." />
  ) : (
    <Panel tone={open ? "accent" : "default"} class="max-w-[42rem]">
      <div class="flex flex-wrap items-start justify-between gap-2">
        <h1 class="m-0 text-sm tracking-wide text-bright">
          {t.game}: {t.name}
        </h1>
        <Badge tone={badge.tone} filled={badge.filled}>
          {badge.label}
        </Badge>
      </div>
      <div class="mt-3 flex flex-col gap-1">
        <Kv label="Mode">{t.mode}</Kv>
        <Kv label="Date" tone={open ? "accent" : "default"}>
          {formatIsoDay(t.date)}
        </Kv>
        <Kv label="Entrants">{t.entrantCount}</Kv>
      </div>

      {!open ? (
        <div class="mt-5 flex flex-wrap items-center gap-4 border-t border-faint pt-4">
          <Alert message="Registration is closed." tone="warn" />
          <Button href="/tournaments" variant="ghost" size="sm">
            ← TOURNAMENTS
          </Button>
        </div>
      ) : (
        <form
          method="POST"
          action={actions.applyToTournament}
          class="mt-5 flex flex-col gap-5 border-t border-faint pt-4 text-xs"
        >
          <input type="hidden" name="id" value={t.id} />

          <fieldset class="skill m-0 min-w-0 border-0 p-0">
            <legend class="mb-3 p-0 text-xs text-dim">
              &gt; skill level
              <span class="text-mute"> # how good are you at {t.game}?</span>
            </legend>
            <div class="cells flex flex-wrap gap-2">
              {SKILL_LEVELS.map(l => (
                <label class="cell relative">
                  <input
                    type="radio"
                    name="skill"
                    value={l.level}
                    checked={l.level === level}
                    required
                    aria-label={`level ${l.level}: ${l.name}`}
                  />
                  <span
                    class="block min-w-[3.25rem] border px-3 py-1.5 text-center text-sm font-bold tracking-wider select-none"
                    aria-hidden="true"
                  >
                    {l.level}
                  </span>
                </label>
              ))}
            </div>
            <div class="mt-3 flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <span
                class="meter text-sm tracking-[0.15em] tabular-nums"
                aria-hidden="true"
              >
                {SKILL_LEVELS.map(() => (
                  <span class="bar">▮</span>
                ))}
              </span>
              {SKILL_LEVELS.map(l => (
                <span class="desc" data-level={l.level}>
                  <span class="text-bright">{l.name}</span>
                  <span class="text-dim"> // {l.blurb}</span>
                </span>
              ))}
            </div>
          </fieldset>

          <div class="border-t border-faint pt-4">
            <div class="mb-3 text-dim">&gt; applying as</div>
            <div
              class="flex items-center gap-4"
              style={`--player:${session.player.glyph.color}`}
            >
              <Glyph glyph={session.player.glyph} size="4rem" framed />
              <div class="min-w-0">
                <div class="truncate text-base leading-tight tracking-wider text-(--player)">
                  {session.player.handle}
                </div>
                <div class="mt-1 text-2xs text-dim">
                  you can retire any time before the deadline.
                </div>
              </div>
            </div>
          </div>

          <Alert error={applied?.error} />
          <div class="flex flex-wrap items-center gap-4">
            <Button>CONFIRM ENTRY</Button>
            <Button href="/tournaments" variant="ghost">
              CANCEL
            </Button>
            <Countdown deadline={t.registrationClosesAt} />
          </div>
        </form>
      )}
    </Panel>
  )}
</Layout>

<style>
  /*
   * The radio covers its whole cell, so the cell is the hit target for a mouse,
   * a finger and a test alike. The number beside it is the picture.
   */
  .cell input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .cell span {
    border-color: var(--color-border);
    color: var(--color-dim);
  }

  .cell:hover span {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .cell:has(input:focus-visible) span {
    outline: 1px solid var(--color-accent);
    outline-offset: 0.125rem;
  }

  /* The picked level and every level below it light up, like a signal meter. */
  .cell:has(input:checked) span,
  .cell:has(~ .cell input:checked) span {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #000;
  }

  .bar {
    color: var(--color-faint);
  }

  .skill:has(input[value="1"]:checked) .bar:nth-child(-n + 1),
  .skill:has(input[value="2"]:checked) .bar:nth-child(-n + 2),
  .skill:has(input[value="3"]:checked) .bar:nth-child(-n + 3),
  .skill:has(input[value="4"]:checked) .bar:nth-child(-n + 4),
  .skill:has(input[value="5"]:checked) .bar:nth-child(-n + 5) {
    color: var(--color-accent);
  }

  /* One description at a time: the one of the picked level. */
  .desc {
    display: none;
  }

  .skill:has(input[value="1"]:checked) .desc[data-level="1"],
  .skill:has(input[value="2"]:checked) .desc[data-level="2"],
  .skill:has(input[value="3"]:checked) .desc[data-level="3"],
  .skill:has(input[value="4"]:checked) .desc[data-level="4"],
  .skill:has(input[value="5"]:checked) .desc[data-level="5"] {
    display: inline;
  }
</style>
