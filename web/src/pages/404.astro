---
import Button from "../components/ui/Button.astro"
import Prompt from "../components/ui/Prompt.astro"
import Layout from "../layouts/Layout.astro"

Astro.response.status = 404
const path = Astro.url.pathname
---

<Layout title="404//LAN_BUNKER">
  <Prompt command={`cd ${path}`} heading="h1" class="mb-0" />
  <p class="mt-2 text-xs text-alert">bash: cd: {path}: no such file or directory</p>
  <p class="mt-6 text-xs text-dim">
    the sector you requested does not exist in this bunker.
  </p>
  <div class="mt-4">
    <Button href="/">HOME</Button>
  </div>
</Layout>
