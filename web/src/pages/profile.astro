---
import { actions } from "astro:actions"
import PlayerCard from "../components/PlayerCard.astro"
import Button from "../components/ui/Button.astro"
import Prompt from "../components/ui/Prompt.astro"
import Layout from "../layouts/Layout.astro"

// The middleware read the cookie before the action deleted it, so on a logout
// the player is still in locals for this one render.
const loggedOut = Astro.getActionResult(actions.logout)
if (loggedOut && !loggedOut.error) return Astro.redirect("/login")

const player = Astro.locals.player
if (!player) return Astro.redirect("/login")

// `/password` and `/handle` redirect here after a change. An action result does
// not survive a redirect, so the flag rides on the query string.
const changed = Astro.url.searchParams.get("changed")
const notice =
  changed === "password" ? "password changed." : changed === "handle" ? "handle changed." : undefined
---

<Layout title={`${player.handle}//LAN_BUNKER`} noindex>
  <Prompt command="whoami" />

  {notice && <p class="mb-4 text-xs text-accent" role="status">{notice}</p>}

  <PlayerCard player={player} own />

  <div class="mt-6 flex flex-wrap items-center gap-3">
    <Button href={`/players/${player.handle}`} variant="ghost">PUBLIC PAGE</Button>
    <Button href="/handle" variant="ghost">CHANGE HANDLE</Button>
    <Button href="/password" variant="ghost">CHANGE PASSWORD</Button>
    {player.role === "admin" && <Button href="/admin" variant="warn">BACKOFFICE</Button>}
    <form method="POST" action={actions.logout}>
      <Button variant="danger">LOGOUT</Button>
    </form>
  </div>
</Layout>
