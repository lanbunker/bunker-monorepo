---
import { actions } from "astro:actions"
import CyclesPanel from "../components/CyclesPanel.astro"
import InactiveNotice from "../components/InactiveNotice.astro"
import MatchPanel from "../components/MatchPanel.astro"
import MedalsPanel from "../components/MedalsPanel.astro"
import NemesisPanel from "../components/NemesisPanel.astro"
import PlayerCard from "../components/PlayerCard.astro"
import StandingPanels from "../components/StandingPanels.astro"
import Alert from "../components/ui/Alert.astro"
import Button from "../components/ui/Button.astro"
import Prompt from "../components/ui/Prompt.astro"
import Layout from "../layouts/Layout.astro"
import { call, dataOf } from "../lib/api"
import { nextEvent } from "../lib/events"
import { noticeFrom } from "../lib/form"
import { RECENT_ENTRIES } from "../lib/paging"
import { sessionOf } from "../lib/session"

// The middleware read the cookie before the action deleted it, so on a logout
// the player is still in locals for this one render.
const loggedOut = Astro.getActionResult(actions.logout)
if (loggedOut && !loggedOut.error) return Astro.redirect("/login")

const session = sessionOf(Astro.locals)
if (!session) return Astro.redirect("/login")
const player = session.player
// The own logs answer for an inactive account too, unlike the public ones. The
// event list is small, so the first page holds the next night.
const recent = { params: { query: { page: 1, pageSize: RECENT_ENTRIES } } }
const [logResult, matchResult, eventResult] = await Promise.all([
  call(client => client.GET("/api/me/cycles", recent), session.token),
  call(client => client.GET("/api/me/matches", recent), session.token),
  player.active
    ? undefined
    : call(client =>
        client.GET("/api/events", { params: { query: { page: 1, pageSize: 100 } } }),
      ),
])
const log = dataOf(logResult)
const matches = dataOf(matchResult)
const events = eventResult && dataOf(eventResult)
const next = nextEvent(events?.items ?? [])

// `/password` and `/handle` redirect here after a change.
const notice = noticeFrom(Astro.url, {
  password: "password changed.",
  handle: "handle changed.",
})
---

<Layout title={`${player.handle}//LAN_BUNKER`} noindex>
  <Prompt heading="div" command="whoami" />

  <Alert message={notice} tone="notice" class="mb-4" />

  {!player.active && <InactiveNotice next={next} known={events !== undefined} />}
  <PlayerCard player={player} own />
  <StandingPanels standing={player.standing} totals={log?.totals} />
  <MedalsPanel />
  {matches?.nemesis && (
    <NemesisPanel handle={player.handle} nemesis={matches.nemesis} own />
  )}

  <MatchPanel handle={player.handle} log={matches} own />
  <CyclesPanel handle={player.handle} log={log} own />

  <div class="mt-6 flex flex-wrap items-center gap-3">
    {player.active && (
      <Button href={`/players/${player.handle}`} variant="ghost">
        PUBLIC PAGE
      </Button>
    )}
    <Button href="/handle" variant="ghost">
      CHANGE HANDLE
    </Button>
    <Button href="/password" variant="ghost">
      CHANGE PASSWORD
    </Button>
    {player.role === "admin" && (
      <Button href="/admin" variant="warn">
        BACKOFFICE
      </Button>
    )}
    <form method="POST" action={actions.logout}>
      <Button variant="danger">LOGOUT</Button>
    </form>
  </div>
</Layout>
