---
import { actions } from "astro:actions"
import Button from "../components/ui/Button.astro"
import Panel from "../components/ui/Panel.astro"
import Prompt from "../components/ui/Prompt.astro"
import Layout from "../layouts/Layout.astro"

const player = Astro.locals.player
if (!player) return Astro.redirect("/login")

const result = Astro.getActionResult(actions.changePassword)
if (result && !result.error) return Astro.redirect("/profile?changed=password")

const forced = Astro.locals.mustChangePassword
---

<Layout title="PASSWD//LAN_BUNKER" noindex>
  <Prompt command="passwd" comment={forced ? "required before you continue" : undefined} />

  {
    forced && (
      <p class="mb-4 text-xs text-warn" role="alert">
        an admin gave you a temporary password. choose your own before you continue.
      </p>
    )
  }

  <Panel class="max-w-[28rem]" tone={forced ? "warn" : "default"}>
    <form method="POST" action={actions.changePassword} class="flex flex-col gap-3 text-xs">
      <label class="flex items-baseline gap-2">
        <span class="w-28 shrink-0 text-dim">current:</span>
        <input
          name="currentPassword"
          type="password"
          required
          minlength="8"
          maxlength="128"
          autocomplete="current-password"
          class="w-full border-b border-border bg-transparent py-1 text-ink outline-none focus:border-accent"
        />
      </label>
      <label class="flex items-baseline gap-2">
        <span class="w-28 shrink-0 text-dim">new:</span>
        <input
          name="newPassword"
          type="password"
          required
          minlength="8"
          maxlength="128"
          autocomplete="new-password"
          class="w-full border-b border-border bg-transparent py-1 text-ink outline-none focus:border-accent"
        />
      </label>
      <label class="flex items-baseline gap-2">
        <span class="w-28 shrink-0 text-dim">repeat new:</span>
        <input
          name="confirmPassword"
          type="password"
          required
          minlength="8"
          maxlength="128"
          autocomplete="new-password"
          class="w-full border-b border-border bg-transparent py-1 text-ink outline-none focus:border-accent"
        />
      </label>
      {
        result?.error && (
          <p class="text-xs text-alert" role="alert">
            {result.error.message}
          </p>
        )
      }
      <div class="mt-2">
        <Button>CHANGE PASSWORD</Button>
      </div>
    </form>
  </Panel>

  {
    !forced && (
      <div class="mt-8">
        <Button href="/profile" variant="ghost" size="sm">← PROFILE</Button>
      </div>
    )
  }
</Layout>
