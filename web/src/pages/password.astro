---
import { actions } from "astro:actions"
import Alert from "../components/ui/Alert.astro"
import Button from "../components/ui/Button.astro"
import Panel from "../components/ui/Panel.astro"
import Prompt from "../components/ui/Prompt.astro"
import Layout from "../layouts/Layout.astro"
import { donePath } from "../lib/form"
import { SITE_FIELD } from "../lib/styles"
import { sessionOf } from "../lib/session"

// The middleware read the cookie before the action deleted it, so on a logout
// the player is still in locals for this one render.
const loggedOut = Astro.getActionResult(actions.logout)
if (loggedOut && !loggedOut.error) return Astro.redirect("/login")

const session = sessionOf(Astro.locals)
if (!session) return Astro.redirect("/login")

const result = Astro.getActionResult(actions.changePassword)
if (result && !result.error) return Astro.redirect(donePath("/profile", "password"))

const forced = session.mustChangePassword
---

<Layout title="PASSWD//LAN_BUNKER" noindex>
  <Prompt
    heading="h1"
    command="passwd"
    comment={forced ? "required before you continue" : undefined}
  />

  {forced && (
    <Alert
      message="an admin gave you a temporary password. choose your own before you continue."
      tone="warn"
      class="mb-4"
    />
  )}

  <Panel class="max-w-[28rem]" tone={forced ? "warn" : "default"}>
    <form
      method="POST"
      action={actions.changePassword}
      class="flex flex-col gap-3 text-xs"
    >
      <label class="flex items-baseline gap-2">
        <span class="w-28 shrink-0 text-dim">current:</span>
        <input
          name="currentPassword"
          type="password"
          required
          minlength="8"
          maxlength="128"
          autocomplete="current-password"
          class={SITE_FIELD}
        />
      </label>
      <label class="flex items-baseline gap-2">
        <span class="w-28 shrink-0 text-dim">new:</span>
        <input
          name="newPassword"
          type="password"
          required
          minlength="8"
          maxlength="128"
          autocomplete="new-password"
          class={SITE_FIELD}
        />
      </label>
      <label class="flex items-baseline gap-2">
        <span class="w-28 shrink-0 text-dim">repeat new:</span>
        <input
          name="confirmPassword"
          type="password"
          required
          minlength="8"
          maxlength="128"
          autocomplete="new-password"
          class={SITE_FIELD}
        />
      </label>
      <Alert error={result?.error} />
      <div class="mt-2">
        <Button>CHANGE PASSWORD</Button>
      </div>
    </form>
  </Panel>

  <div class="mt-8">
    {forced ? (
      <form method="POST" action={actions.logout}>
        <Button variant="ghost" size="sm">
          LOGOUT
        </Button>
      </form>
    ) : (
      <Button href="/profile" variant="ghost" size="sm">
        ← PROFILE
      </Button>
    )}
  </div>
</Layout>
