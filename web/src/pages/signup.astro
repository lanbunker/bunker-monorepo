---
import { actions } from "astro:actions"
import BootLog from "../components/BootLog.astro"
import BunkernetFrame from "../components/BunkernetFrame.astro"
import Alert from "../components/ui/Alert.astro"
import Button from "../components/ui/Button.astro"
import Panel from "../components/ui/Panel.astro"
import Prompt from "../components/ui/Prompt.astro"
import Layout from "../layouts/Layout.astro"
import { localPath } from "../lib/schemas"
import { SITE_FIELD } from "../lib/styles"
import { sessionOf } from "../lib/session"

// `?next=` brings a player back where they came from, such as the door of an
// event. Only a path of this site passes.
const next = localPath.safeParse(Astro.url.searchParams.get("next")).data
if (sessionOf(Astro.locals)) return Astro.redirect(next ?? "/profile")

// A success renders the boot sequence on the POST itself, then moves to the
// profile, or to `next`. The response belongs to one signup, so no cache keeps it.
const result = Astro.getActionResult(actions.signup)
const created = result?.data?.handle
const destination = result?.data?.next ?? "/profile"
// A refused signup keeps the handle. The two password fields start empty again.
const typed = Astro.locals.submitted.handle ?? ""
if (created) Astro.response.headers.set("Cache-Control", "no-store")
---

<Layout title="ENLIST//BUNKERNET" bare>
  <BunkernetFrame
    subtitle={created ? "── new player ──" : "── player network ──"}
    homeLink={!created}
  >
    {created ? (
      <div>
        <Prompt heading="h1" host="bunkernet:~$" command={`useradd ${created}`} />
        <BootLog
          lines={[
            `creating home /players/${created}`,
            "generating glyph",
            "issuing session token",
            "joining bunkernet",
          ]}
          greeting={`welcome, ${created}.`}
          destination={destination}
        />
      </div>
    ) : (
      <div>
        <Prompt heading="h1" host="bunkernet:~$" command="useradd --create-home" />
        <Panel>
          <form
            method="POST"
            action={actions.signup}
            class="flex flex-col gap-3 text-xs"
            autocomplete="on"
          >
            {next && <input type="hidden" name="next" value={next} />}
            <label class="flex items-baseline gap-2">
              <span class="w-24 shrink-0 text-dim">handle:</span>
              <input
                name="handle"
                type="text"
                required
                minlength="3"
                maxlength="20"
                pattern="[A-Za-z0-9_.\-]+"
                title="3 to 20 characters: letters, digits, _ . -"
                autocomplete="username"
                autofocus
                value={typed}
                class={SITE_FIELD}
              />
            </label>
            <p class="m-0 -mt-1 pl-26 text-2xs text-mute">
              your name everywhere in bunkernet: roster, cabinets, tournaments. you can
              change it later from your profile.
            </p>
            <label class="flex items-baseline gap-2">
              <span class="w-24 shrink-0 text-dim">password:</span>
              <input
                name="password"
                type="password"
                required
                minlength="8"
                maxlength="128"
                autocomplete="new-password"
                class={SITE_FIELD}
              />
            </label>
            <label class="flex items-baseline gap-2">
              <span class="w-24 shrink-0 text-dim">repeat:</span>
              <input
                name="confirmPassword"
                type="password"
                required
                minlength="8"
                maxlength="128"
                autocomplete="new-password"
                class={SITE_FIELD}
              />
            </label>
            <Alert error={result?.error} />
            <div class="mt-2 flex items-center gap-4">
              <Button>ENLIST</Button>
              <a
                href={next ? `/login?next=${encodeURIComponent(next)}` : "/login"}
                class="text-2xs text-dim no-underline hover:text-accent"
              >
                have an account? login →
              </a>
            </div>
          </form>
        </Panel>
      </div>
    )}
  </BunkernetFrame>
</Layout>
