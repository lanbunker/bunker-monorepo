---
import { actions } from "astro:actions"
// The Turnstile widget calls its callbacks by name, and it can finish before a
// bundled module runs. So the callbacks are an inline script placed before the
// widget script, and ENLIST stays disabled until the check passes. The row keeps
// the 4.0625rem (65px) of the widget before it loads, so the form does not jump.
// The widget sits inline in its shadow root, so a line height adds a gap under
// it. `leading-0` reaches into the shadow root and holds the row at 65px. The
// label sits at the top of the row, as the labels of the text fields do.
// A blocked widget script calls nothing, so the inline script says so itself
// after a wait.
import { TURNSTILE_SITE_KEY } from "astro:env/server"

import BootLog from "../components/BootLog.astro"
import BunkernetFrame from "../components/BunkernetFrame.astro"
import Alert from "../components/ui/Alert.astro"
import Button from "../components/ui/Button.astro"
import Panel from "../components/ui/Panel.astro"
import Prompt from "../components/ui/Prompt.astro"
import Layout from "../layouts/Layout.astro"
import { TURNSTILE_ACTION, localPath } from "../lib/schemas"
import { SITE_FIELD } from "../lib/styles"
import { sessionOf } from "../lib/session"

// `?next=` brings a player back where they came from, such as the door of an
// event. Only a path of this site passes.
const next = localPath.safeParse(Astro.url.searchParams.get("next")).data
if (sessionOf(Astro.locals)) return Astro.redirect(next ?? "/profile")

// A success renders the boot sequence on the POST itself, then moves to the
// profile, or to `next`. The response belongs to one signup, so no cache keeps it.
const result = Astro.getActionResult(actions.signup)
const created = result?.data?.handle
const destination = result?.data?.next ?? "/profile"
// A refused signup keeps the handle. The two password fields start empty again.
const typed = Astro.locals.submitted.handle ?? ""
if (created) Astro.response.headers.set("Cache-Control", "no-store")
---

<Layout title="ENLIST//BUNKERNET" bare>
  <BunkernetFrame
    subtitle={created ? "── new player ──" : "── player network ──"}
    homeLink={!created}
  >
    {created ? (
      <div>
        <Prompt heading="h1" host="bunkernet:~$" command={`useradd ${created}`} />
        <BootLog
          lines={[
            `creating home /players/${created}`,
            "generating glyph",
            "issuing session token",
            "joining bunkernet",
          ]}
          greeting={`welcome, ${created}.`}
          destination={destination}
        />
      </div>
    ) : (
      <div>
        <Prompt heading="h1" host="bunkernet:~$" command="useradd --create-home" />
        <Panel>
          <form
            method="POST"
            action={actions.signup}
            class="flex flex-col gap-3 text-xs"
            autocomplete="on"
            data-bot-check
          >
            {next && <input type="hidden" name="next" value={next} />}
            <label class="flex items-baseline gap-2">
              <span class="w-24 shrink-0 text-dim">handle:</span>
              <input
                name="handle"
                type="text"
                required
                minlength="3"
                maxlength="20"
                pattern="[A-Za-z0-9_.\-]+"
                title="3 to 20 characters: letters, digits, _ . -"
                autocomplete="username"
                autofocus
                value={typed}
                class={SITE_FIELD}
              />
            </label>
            <p class="m-0 -mt-1 pl-26 text-2xs text-mute">
              your name everywhere in bunkernet: roster, cabinets, tournaments. you can
              change it later from your profile.
            </p>
            <label class="flex items-baseline gap-2">
              <span class="w-24 shrink-0 text-dim">password:</span>
              <input
                name="password"
                type="password"
                required
                minlength="8"
                maxlength="128"
                autocomplete="new-password"
                class={SITE_FIELD}
              />
            </label>
            <label class="flex items-baseline gap-2">
              <span class="w-24 shrink-0 text-dim">repeat:</span>
              <input
                name="confirmPassword"
                type="password"
                required
                minlength="8"
                maxlength="128"
                autocomplete="new-password"
                class={SITE_FIELD}
              />
            </label>
            <div class="flex flex-wrap items-start gap-2">
              <span class="w-24 shrink-0 text-dim">human:</span>
              <div
                class="cf-turnstile min-h-[4.0625rem] min-w-0 leading-0 flex-1 max-[30rem]:basis-full"
                data-sitekey={TURNSTILE_SITE_KEY}
                data-action={TURNSTILE_ACTION}
                data-theme="dark"
                data-size="flexible"
                data-callback="bunkerBotCheckPassed"
                data-error-callback="bunkerBotCheckFailed"
                data-expired-callback="bunkerBotCheckExpired"
              ></div>
            </div>
            <p class="m-0 -mt-1 pl-26 text-2xs text-mute" role="status" data-bot-status>
              waiting for the bot check…
            </p>
            <noscript>
              <p class="text-2xs text-warn">the bot check needs JavaScript to enlist.</p>
            </noscript>
            <Alert error={result?.error} />
            <div class="mt-2 flex items-center gap-4">
              <Button disabled>ENLIST</Button>
              <a
                href={next ? `/login?next=${encodeURIComponent(next)}` : "/login"}
                class="text-2xs text-dim no-underline hover:text-accent"
              >
                have an account? login →
              </a>
            </div>
          </form>
        </Panel>
        <script is:inline>
          {
            const forms = document.querySelectorAll("[data-bot-check]")
            const show = (enabled, status) => {
              for (const form of forms) {
                for (const button of form.querySelectorAll("button[type=submit]")) {
                  button.disabled = !enabled
                }
                for (const line of form.querySelectorAll("[data-bot-status]")) {
                  line.textContent = status
                }
              }
            }
            window.bunkerBotCheckPassed = () => show(true, "")
            window.bunkerBotCheckFailed = () =>
              show(false, "the bot check failed. reload the page.")
            window.bunkerBotCheckExpired = () =>
              show(false, "the bot check expired. wait for a new one.")
            setTimeout(() => {
              if (!("turnstile" in window)) {
                show(
                  false,
                  "the bot check did not load. check your connection or disable a blocker for challenges.cloudflare.com.",
                )
              }
            }, 10000)
          }
        </script>
        <script
          is:inline
          src="https://challenges.cloudflare.com/turnstile/v0/api.js"
          async
          defer
        ></script>
      </div>
    )}
  </BunkernetFrame>
</Layout>
