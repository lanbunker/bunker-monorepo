---
import { getEntry } from "astro:content"
import Panel from "../components/ui/Panel.astro"
import Prompt from "../components/ui/Prompt.astro"
import Layout from "../layouts/Layout.astro"

const entry = await getEntry("about", "about")
const title = entry?.data.title ?? "README.txt"
---

<Layout title="ABOUT//LAN_BUNKER" active="about">
  <Prompt command={`cat ${title}`} />

  <Panel>
    <pre class="m-0 font-mono text-xs leading-[1.9] whitespace-pre-wrap wrap-break-word text-ink">{entry?.body?.trim()}</pre>
  </Panel>
</Layout>
