---
import CyclesPanel from "../../components/CyclesPanel.astro"
import MatchPanel from "../../components/MatchPanel.astro"
import NemesisPanel from "../../components/NemesisPanel.astro"
import PlayerCard from "../../components/PlayerCard.astro"
import StandingPanels from "../../components/StandingPanels.astro"
import Alert from "../../components/ui/Alert.astro"
import Button from "../../components/ui/Button.astro"
import Prompt from "../../components/ui/Prompt.astro"
import Layout from "../../layouts/Layout.astro"
import { call, dataOf, failureOf, isMissing } from "../../lib/api"
import { RECENT_ENTRIES } from "../../lib/paging"
import { sessionOf } from "../../lib/session"

const handle = Astro.params.handle ?? ""
const [result, logResult, matchResult] = await Promise.all([
  call(client => client.GET("/api/players/{handle}", { params: { path: { handle } } })),
  call(client =>
    client.GET("/api/players/{handle}/cycles", {
      params: { path: { handle }, query: { page: 1, pageSize: RECENT_ENTRIES } },
    }),
  ),
  call(client =>
    client.GET("/api/players/{handle}/matches", {
      params: { path: { handle }, query: { page: 1, pageSize: RECENT_ENTRIES } },
    }),
  ),
])
const failure = failureOf(result)
if (failure && isMissing(failure)) return Astro.rewrite("/404")

const player = dataOf(result)
const log = dataOf(logResult)
const matches = dataOf(matchResult)
const own = player !== undefined && sessionOf(Astro.locals)?.player.id === player.id
---

<Layout title={`${player?.handle ?? handle}//LAN_BUNKER`} active="players">
  <Prompt heading="p" command={`cat /players/${handle}`} />

  {player ? (
    <>
      <PlayerCard player={player} own={own} />
      <StandingPanels standing={player.standing} totals={log?.totals} />
      {matches?.nemesis && (
        <NemesisPanel handle={handle} nemesis={matches.nemesis} own={own} />
      )}

      <MatchPanel handle={handle} log={matches} own={own} />
      <CyclesPanel handle={handle} log={log} own={own} />
    </>
  ) : (
    <Alert message="The player database is unreachable." />
  )}

  <div class="mt-8">
    <Button href="/players" variant="ghost" size="sm">
      ← PLAYERS
    </Button>
  </div>
</Layout>
