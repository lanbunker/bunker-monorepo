---
import PlayerCard from "../../components/PlayerCard.astro"
import Button from "../../components/ui/Button.astro"
import Prompt from "../../components/ui/Prompt.astro"
import Layout from "../../layouts/Layout.astro"
import { apiClient } from "../../lib/api"

const handle = Astro.params.handle ?? ""
const { data: player, response } = await apiClient()
  .GET("/api/players/{handle}", { params: { path: { handle } } })
  .catch(() => ({ data: undefined, response: undefined }))

if (!player && response?.status === 404) return Astro.rewrite("/404")
const own = Astro.locals.player?.id === player?.id
---

<Layout title={`${player?.handle ?? handle}//LAN_BUNKER`} active="players">
  <Prompt command={`cat /players/${handle}`} />

  {
    player ? (
      <PlayerCard player={player} own={own} />
    ) : (
      <p class="text-xs text-alert">the player database is unreachable.</p>
    )
  }

  <div class="mt-8">
    <Button href="/players" variant="ghost" size="sm">← PLAYERS</Button>
  </div>
</Layout>
