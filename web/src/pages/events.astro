---
import EventCard from "../components/EventCard.astro"
import Alert from "../components/ui/Alert.astro"
import Prompt from "../components/ui/Prompt.astro"
import Layout from "../layouts/Layout.astro"
import { call, dataOf } from "../lib/api"
import { phaseOf } from "../lib/events"

// A few nights a year, so one page holds them all for a long time. The API
// answers the latest night first.
const listed = dataOf(
  await call(client =>
    client.GET("/api/events", { params: { query: { page: 1, pageSize: 100 } } }),
  ),
)
const items = listed?.items ?? []
// The soonest night first among the ones still to come, the latest first in
// the archive.
const upcoming = items.filter(e => phaseOf(e) !== "past").toReversed()
const previous = items.filter(e => phaseOf(e) === "past")
---

<Layout title="EVENTS//LAN_BUNKER" active="events" events={listed?.items}>
  <Prompt command="ls -la ./upcoming" comment={`${upcoming.length} entries`} />

  {!listed ? (
    <Alert message="The event database is unreachable." />
  ) : upcoming.length > 0 ? (
    <div class="flex flex-col gap-6">
      {upcoming.map(ev => (
        <EventCard event={ev} />
      ))}
    </div>
  ) : (
    <p class="text-xs text-dim">no upcoming events.</p>
  )}

  {previous.length > 0 && (
    <>
      <Prompt command="ls -la ./archive" comment={`${previous.length} entries`} />
      <div class="flex flex-col gap-6">
        {previous.map(ev => (
          <EventCard event={ev} />
        ))}
      </div>
    </>
  )}
</Layout>
