---
import { actions } from "astro:actions"
import Alert from "../../components/ui/Alert.astro"
import Button from "../../components/ui/Button.astro"
import Glyph from "../../components/ui/Glyph.astro"
import Pager from "../../components/ui/Pager.astro"
import RankMark from "../../components/ui/RankMark.astro"
import SearchBar from "../../components/ui/SearchBar.astro"
import Table from "../../components/ui/Table.astro"
import AdminLayout from "../../layouts/AdminLayout.astro"
import { call, dataOf } from "../../lib/api"
import { formatCycles } from "../../lib/cycles"
import { formatDate } from "../../lib/dates"
import { donePath, firstError, noticeFrom } from "../../lib/form"
import { PAGE_SIZE, listPath, pageFrom, searchFrom } from "../../lib/paging"
import { adminSessionOf } from "../../lib/session"

const session = adminSessionOf(Astro.locals)
if (!session) return Astro.rewrite("/404")

// Role, rename and delete redirect after success, so a refresh cannot repeat
// them. The temporary password shows once, so that one renders on the POST.
const roleResult = Astro.getActionResult(actions.setRole)
const deleteResult = Astro.getActionResult(actions.deletePlayer)
const renameResult = Astro.getActionResult(actions.renamePlayer)
const resetResult = Astro.getActionResult(actions.resetPassword)
const adjustResult = Astro.getActionResult(actions.adjustCycles)

/** Where a change sends the admin, with a known key and the handle it touched. */
const afterChange = (): string | undefined => {
  const role = roleResult?.data
  if (role) {
    return donePath(
      "/admin/players",
      role.role === "admin" ? "promoted" : "demoted",
      role.handle,
    )
  }
  if (deleteResult?.data) return donePath("/admin/players", "deleted")
  const renamed = renameResult?.data
  if (renamed) return donePath("/admin/players", "renamed", renamed.handle)
  const adjusted = adjustResult?.data
  if (adjusted) {
    return donePath(
      "/admin/players",
      adjusted.amount < 0 ? "penalized" : "rewarded",
      adjusted.handle,
    )
  }
  return undefined
}
const changed = afterChange()
if (changed) return Astro.redirect(changed)

// A temporary password is in this response. It belongs to one request only.
Astro.response.headers.set("Cache-Control", "no-store")

const failure = firstError(
  roleResult,
  deleteResult,
  renameResult,
  resetResult,
  adjustResult,
)
// A refused adjustment keeps what was typed in its row.
const typed = Astro.locals.submitted
// Only a known key renders. The query string is anyone's to write, and `who`
// is a handle the API validated before the redirect carried it.
const who = Astro.url.searchParams.get("who") ?? ""
const notice = noticeFrom(Astro.url, {
  promoted: `${who} is now admin`,
  demoted: `${who} is now user`,
  renamed: `renamed to ${who}`,
  deleted: "player deleted",
  rewarded: `cycles added to ${who}`,
  penalized: `cycles taken from ${who}`,
})
const temporaryPassword = resetResult?.data?.temporaryPassword

const page = pageFrom(Astro.url)
const q = searchFrom(Astro.url)
const result = await call(
  client =>
    client.GET("/api/admin/players", {
      params: { query: { page, pageSize: PAGE_SIZE, q } },
    }),
  session.token,
)
const roster = dataOf(result)
if (roster && page > roster.totalPages && roster.totalPages > 0) {
  return Astro.redirect(listPath("/admin/players", q, roster.totalPages))
}
---

<AdminLayout title="BACKOFFICE//players" active="players">
  <SearchBar
    action="/admin/players"
    command="players |"
    value={q}
    comment={
      !roster
        ? "? rows"
        : q === undefined
          ? `${roster.total} rows`
          : `${roster.total} ${roster.total === 1 ? "match" : "matches"}`
    }
    tone="admin"
    heading="h1"
  />

  <Alert message={notice} tone="warn" class="mt-3" />
  {temporaryPassword && (
    <div class="mt-3 border border-warn bg-warn/10 p-3 text-xs" role="status">
      <p class="m-0 text-warn">temporary password, shown once. hand it over in person.</p>
      <p class="m-0 mt-1 text-base tracking-wider text-admin-ink select-all">
        {temporaryPassword}
      </p>
      <p class="m-0 mt-1 text-2xs text-admin-dim">
        the player must change it at the next login.
      </p>
    </div>
  )}
  <Alert error={failure} class="mt-3" />

  <div class="mt-4 border border-warn/40">
    {!roster ? (
      <p class="p-4 text-xs text-alert">the api is unreachable.</p>
    ) : (
      <Table label="players">
        <thead>
          <tr class="bg-warn/10 text-left text-2xs tracking-wider text-admin-dim">
            <th class="w-[20%] px-3 py-2 font-normal">player</th>
            <th class="w-[8%] px-3 py-2 font-normal">role</th>
            <th class="w-[17%] px-3 py-2 font-normal">cycles</th>
            <th class="w-[12%] px-3 py-2 font-normal">enlisted</th>
            <th class="w-[43%] px-3 py-2 text-right font-normal">actions</th>
          </tr>
        </thead>
        <tbody>
          {roster.items.map(player => (
            <tr class="border-t border-warn/20">
              <td class="px-3 py-2">
                <a
                  href={`/players/${player.handle}`}
                  class="inline-flex items-center gap-2 no-underline text-admin-ink hover:text-warn"
                >
                  <Glyph glyph={player.glyph} size="1.1em" />
                  <span class="handle" title={player.handle}>
                    {player.handle}
                  </span>
                </a>
              </td>
              <td
                class:list={[
                  "px-3 py-2",
                  player.role === "admin" ? "text-warn" : "text-admin-dim",
                ]}
              >
                {player.role}
              </td>
              <td class="px-3 py-2">
                <span class="inline-flex flex-wrap items-baseline gap-x-2">
                  <span class="text-warn tabular-nums" data-cycles>
                    {formatCycles(player.standing.cycles)}
                  </span>
                  <RankMark rank={player.standing.rank} labelled />
                </span>
              </td>
              <td class="px-3 py-2 text-admin-dim">
                {formatDate(new Date(player.createdAt))}
              </td>
              <td class="px-3 py-2">
                {player.id === session.player.id ? (
                  <span class="text-2xs text-admin-dim">this is you</span>
                ) : (
                  <div class="flex flex-wrap justify-end gap-2">
                    <form method="POST" action={actions.setRole}>
                      <input type="hidden" name="id" value={player.id} />
                      <input
                        type="hidden"
                        name="role"
                        value={player.role === "admin" ? "user" : "admin"}
                      />
                      <Button variant="warn" size="sm">
                        {player.role === "admin" ? "demote" : "promote"}
                      </Button>
                    </form>
                    <form
                      method="POST"
                      action={actions.renamePlayer}
                      class="flex items-center gap-1"
                    >
                      <input type="hidden" name="id" value={player.id} />
                      <input
                        name="handle"
                        type="text"
                        required
                        minlength="3"
                        maxlength="20"
                        pattern="[A-Za-z0-9_.\-]+"
                        placeholder={player.handle}
                        aria-label={`new handle for ${player.handle}`}
                        class="w-24 border-b border-warn/40 bg-transparent px-1 py-0.5 text-2xs text-admin-ink outline-none focus:border-warn"
                      />
                      <Button variant="warn" size="sm">
                        rename
                      </Button>
                    </form>
                    <form
                      method="POST"
                      action={actions.adjustCycles}
                      class="flex items-center gap-1"
                    >
                      <input type="hidden" name="id" value={player.id} />
                      <input type="hidden" name="handle" value={player.handle} />
                      <input
                        name="amount"
                        type="number"
                        required
                        min="-10000"
                        max="10000"
                        step="1"
                        placeholder="±cycles"
                        aria-label={`cycles for ${player.handle}`}
                        value={typed.id === player.id ? typed.amount : undefined}
                        class="w-20 border-b border-warn/40 bg-transparent px-1 py-0.5 text-2xs text-admin-ink outline-none focus:border-warn"
                      />
                      <input
                        name="note"
                        type="text"
                        required
                        maxlength="200"
                        placeholder="why"
                        aria-label={`reason for the cycles of ${player.handle}`}
                        value={typed.id === player.id ? typed.note : undefined}
                        class="w-32 border-b border-warn/40 bg-transparent px-1 py-0.5 text-2xs text-admin-ink outline-none focus:border-warn"
                      />
                      <Button variant="warn" size="sm">
                        adjust
                      </Button>
                    </form>
                    <form
                      method="POST"
                      action={actions.resetPassword}
                      data-confirm={`reset the password of ${player.handle}? the current one stops working.`}
                    >
                      <input type="hidden" name="id" value={player.id} />
                      <Button variant="warn" size="sm">
                        reset password
                      </Button>
                    </form>
                    <form
                      method="POST"
                      action={actions.deletePlayer}
                      data-confirm={`delete ${player.handle}? this cannot be undone.`}
                    >
                      <input type="hidden" name="id" value={player.id} />
                      <Button variant="danger" size="sm">
                        delete
                      </Button>
                    </form>
                  </div>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </Table>
    )}
  </div>
  {roster && (
    <Pager
      page={page}
      totalPages={roster.totalPages}
      total={roster.total}
      href="/admin/players"
      q={q}
      noun="player"
    />
  )}
</AdminLayout>
