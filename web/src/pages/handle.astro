---
import { actions } from "astro:actions"
import Alert from "../components/ui/Alert.astro"
import Button from "../components/ui/Button.astro"
import Panel from "../components/ui/Panel.astro"
import Prompt from "../components/ui/Prompt.astro"
import Layout from "../layouts/Layout.astro"
import { SITE_FIELD } from "../lib/styles"
import { sessionOf } from "../lib/session"

const session = sessionOf(Astro.locals)
if (!session) return Astro.redirect("/login")

const result = Astro.getActionResult(actions.changeHandle)
if (result && !result.error) return Astro.redirect("/profile?changed=handle")
// A refused rename keeps what was typed, not the handle in force.
const typed = Astro.locals.submitted.handle ?? session.player.handle
---

<Layout title="RENAME//LAN_BUNKER" noindex>
  <Prompt command="usermod --login" comment="your glyph stays" />

  <Panel class="max-w-[28rem]">
    <form method="POST" action={actions.changeHandle} class="flex flex-col gap-3 text-xs">
      <label class="flex items-baseline gap-2">
        <span class="w-28 shrink-0 text-dim">new handle:</span>
        <input
          name="handle"
          type="text"
          required
          minlength="3"
          maxlength="20"
          pattern="[A-Za-z0-9_.\-]+"
          title="3 to 20 characters: letters, digits, _ . -"
          autocomplete="username"
          value={typed}
          class={SITE_FIELD}
        />
      </label>
      <p class="m-0 text-2xs text-mute">
        the old handle frees up for someone else. links to your old public page stop
        working.
      </p>
      <Alert error={result?.error} />
      <div class="mt-2">
        <Button>RENAME</Button>
      </div>
    </form>
  </Panel>

  <div class="mt-8">
    <Button href="/profile" variant="ghost" size="sm">
      ← PROFILE
    </Button>
  </div>
</Layout>
