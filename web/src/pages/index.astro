---
import { getCollection } from "astro:content"
import AsciiBanner from "../components/AsciiBanner.astro"
import Button from "../components/ui/Button.astro"
import Kv from "../components/ui/Kv.astro"
import Panel from "../components/ui/Panel.astro"
import { isRegistrationOpen, upcomingTournament } from "../data/tournaments"
import Layout from "../layouts/Layout.astro"
import { formatEurDate, parseEurDate } from "../lib/dates"

const events = (await getCollection("events")).sort(
  (a, b) => parseEurDate(b.data.date) - parseEurDate(a.data.date),
)

// Events sort newest first, so the last upcoming entry is the soonest one.
const nextEvent = events.findLast(e => e.data.status === "OPEN" || e.data.status === "SOON")
const prevEvent = events.find(e => e.data.status === "CLOSED")
const canRegister = upcomingTournament ? isRegistrationOpen(upcomingTournament) : false
---

<Layout title="LAN BUNKER" active="home">
  <AsciiBanner text="BUNKER" class="h-48 max-[30rem]:h-36 min-[62.5rem]:h-72" />

  <div class="-mt-2 text-center text-2xs tracking-wider text-dim">
    ── local area network party ──
  </div>

  <div class="mt-8">
    <div class="flex flex-wrap items-baseline gap-x-2 text-sm">
      <span class="text-dim">bunker@office:~$</span>
      <span class="text-accent-soft">./enter.sh</span>
    </div>
    <ol id="boot-log" class="m-0 mt-2 list-none p-0 text-xs text-dim" aria-live="polite"></ol>
    <p id="tagline" class="mt-2 hidden text-base text-bright">
      Enter the bunker. LAN party reimagined for the modern age.<span
        class="animate-blink text-accent"
        aria-hidden="true">█</span
      >
    </p>

    <div id="status-block" class="mt-6 hidden">
      <Panel>
        <div class="flex flex-col gap-1">
          <Kv label="System" tone="accent">■ online</Kv>
          <Kv label="Next event">
            {
              nextEvent ? (
                <a href="/events" class="text-bright no-underline hover:text-accent">
                  {formatEurDate(nextEvent.data.date)} // {nextEvent.data.name}
                </a>
              ) : (
                "to be announced"
              )
            }
          </Kv>
          {
            prevEvent && (
              <Kv label="Previous event">
                <a href="/events" class="text-bright no-underline hover:text-accent">
                  {formatEurDate(prevEvent.data.date)} // {prevEvent.data.name}
                </a>
              </Kv>
            )
          }
          {
            upcomingTournament && (
              <Kv label="Tournament" tone={canRegister ? "accent" : "default"}>
                {upcomingTournament.game} // {upcomingTournament.name}
                {!canRegister && <span class="text-dim"> // registration closed</span>}
              </Kv>
            )
          }
        </div>
        <div class="mt-4 flex flex-wrap gap-3">
          <Button href="/events" variant="ghost">EVENTS</Button>
          {canRegister && <Button href="/tournaments">REGISTER</Button>}
        </div>
      </Panel>
    </div>
  </div>

  <script>
    const BOOT_LINES = [
      "mounting /dev/bunker",
      "loading events",
      "checking tournaments",
      "uplink established",
    ]
    const STEP_MS = 110

    const log = document.getElementById("boot-log")
    const tagline = document.getElementById("tagline")
    const statusBlock = document.getElementById("status-block")
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches

    const printLine = (text: string) => {
      const li = document.createElement("li")
      li.innerHTML = `<span class="text-accent">[ OK ]</span> ${text}`
      log?.append(li)
    }

    const finish = () => {
      tagline?.classList.remove("hidden")
      statusBlock?.classList.remove("hidden")
    }

    if (reduced) {
      for (const line of BOOT_LINES) printLine(line)
      finish()
    } else {
      BOOT_LINES.map((line, i) => setTimeout(() => printLine(line), STEP_MS * (i + 1)))
      setTimeout(finish, STEP_MS * (BOOT_LINES.length + 1))
    }
  </script>
</Layout>
