---
import { getCollection } from "astro:content"
import AsciiBanner from "../components/AsciiBanner.astro"
import Button from "../components/ui/Button.astro"
import Kv from "../components/ui/Kv.astro"
import Panel from "../components/ui/Panel.astro"
import Layout from "../layouts/Layout.astro"
import { apiClient } from "../lib/api"
import { formatEurDate, parseEurDate } from "../lib/dates"
import { isRegistrationOpen, nextOpen } from "../lib/tournaments"

const events = (await getCollection("events")).sort(
  (a, b) => parseEurDate(b.data.date) - parseEurDate(a.data.date),
)

// Events sort newest first, so the last upcoming entry is the soonest one.
const nextEvent = events.findLast(e => e.data.status === "OPEN" || e.data.status === "SOON")
const prevEvent = events.find(e => e.data.status === "CLOSED")
// One row proves the API is up and carries the head count. The tournament list
// is small, so the first page holds every open one.
const client = apiClient()
const [{ data: net }, { data: tournaments }] = await Promise.all([
  client.GET("/api/players", { params: { query: { page: 1, pageSize: 1 } } }).catch(() => ({ data: undefined })),
  client
    .GET("/api/tournaments", { params: { query: { page: 1, pageSize: 100 } } })
    .catch(() => ({ data: undefined })),
])
const netOnline = net !== undefined
const upcomingTournament = nextOpen(tournaments?.items ?? [])
const canRegister = upcomingTournament ? isRegistrationOpen(upcomingTournament) : false
---

<Layout title="LAN BUNKER" active="home">
  <AsciiBanner text="BUNKERNET" hollow="NET" class="h-40 max-[30rem]:h-28 min-[62.5rem]:h-60" />

  <div class="-mt-2 text-center text-2xs tracking-wider text-dim">
    ── local area network party ──
  </div>

  <div class="mt-8">
    <div class="flex flex-wrap items-baseline gap-x-2 text-sm">
      <span class="text-dim">bunker@office:~$</span>
      <span class="text-accent-soft">./enter.sh</span>
    </div>
    <ol
      id="boot-log"
      data-net-online={netOnline ? "1" : "0"}
      class="m-0 mt-2 list-none p-0 text-xs text-dim"
      aria-live="polite"
    ></ol>
    <p id="tagline" class="mt-2 hidden text-base text-bright">
      Enter the bunker. LAN party reimagined for the modern age.<span
        class="animate-blink text-accent"
        aria-hidden="true">█</span
      >
    </p>

    <div id="status-block" class="mt-6 hidden">
      <Panel>
        <div class="flex flex-col gap-1">
          <Kv label="System" tone={netOnline ? "accent" : "alert"}>{netOnline ? "■ online" : "■ degraded"}</Kv>
          <Kv label="Bunkernet" tone={netOnline ? "default" : "alert"}>
            {
              net ? (
                <a href="/players" class="text-bright no-underline hover:text-accent">
                  {net.total} {net.total === 1 ? "player" : "players"} enlisted
                </a>
              ) : (
                "api offline"
              )
            }
          </Kv>
          <Kv label="Next event">
            {
              nextEvent ? (
                <a href="/events" class="text-bright no-underline hover:text-accent">
                  {formatEurDate(nextEvent.data.date)} // {nextEvent.data.name}
                </a>
              ) : (
                "to be announced"
              )
            }
          </Kv>
          {
            prevEvent && (
              <Kv label="Previous event">
                <a href="/events" class="text-bright no-underline hover:text-accent">
                  {formatEurDate(prevEvent.data.date)} // {prevEvent.data.name}
                </a>
              </Kv>
            )
          }
          {
            upcomingTournament && (
              <Kv label="Tournament" tone={canRegister ? "accent" : "default"}>
                <a href="/tournaments" class="no-underline hover:text-bright">
                  {upcomingTournament.game} // {upcomingTournament.name}
                </a>
                {!canRegister && <span class="text-dim"> // registration closed</span>}
              </Kv>
            )
          }
        </div>
        <div class="mt-4 flex flex-wrap gap-3">
          <Button href="/events" variant="ghost">EVENTS</Button>
          {canRegister && <Button href="/tournaments">APPLY</Button>}
        </div>
      </Panel>

      {
        netOnline && !Astro.locals.player && (
          <Panel tone="accent" class="mt-4">
            <div class="flex flex-wrap items-center justify-between gap-4">
              <div>
                <div class="text-xs tracking-wider text-accent">bunkernet // player network</div>
                <p class="m-0 mt-1 text-xs text-dim">
                  one handle for the roster, the cabinets and every tournament.
                </p>
              </div>
              <div class="flex items-center gap-4">
                <Button href="/signup">ENTER BUNKERNET</Button>
                <a href="/login" class="text-2xs text-dim no-underline hover:text-accent">login →</a>
              </div>
            </div>
          </Panel>
        )
      }
    </div>
  </div>

  <script>
    const log = document.getElementById("boot-log")
    const netOnline = log?.dataset.netOnline === "1"
    const BOOT_LINES = [
      { text: "mounting /dev/bunker", ok: true },
      { text: "loading events", ok: true },
      { text: "checking tournaments", ok: true },
      { text: "bunkernet uplink", ok: netOnline },
    ]
    const STEP_MS = 110

    const tagline = document.getElementById("tagline")
    const statusBlock = document.getElementById("status-block")
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches

    const printLine = (line: { text: string; ok: boolean }) => {
      const li = document.createElement("li")
      const tag = document.createElement("span")
      tag.className = line.ok ? "text-accent" : "text-alert"
      tag.textContent = line.ok ? "[  OK ]" : "[ERROR]"
      li.append(tag, ` ${line.text}`)
      log?.append(li)
    }

    const finish = () => {
      tagline?.classList.remove("hidden")
      statusBlock?.classList.remove("hidden")
    }

    if (reduced) {
      for (const line of BOOT_LINES) printLine(line)
      finish()
    } else {
      BOOT_LINES.map((line, i) => setTimeout(() => printLine(line), STEP_MS * (i + 1)))
      setTimeout(finish, STEP_MS * (BOOT_LINES.length + 1))
    }
  </script>
</Layout>
