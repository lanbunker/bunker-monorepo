---
import type { Rivalry } from "../lib/api"
import { played } from "../lib/matches"
import PlayerLink from "./PlayerLink.astro"
import Glyph from "./ui/Glyph.astro"
import Panel from "./ui/Panel.astro"
import Prompt from "./ui/Prompt.astro"
import RankMark from "./ui/RankMark.astro"

interface Props {
  handle: string
  /** The API answers one only past the threshold, so the panel is never empty. */
  nemesis: Rivalry
  /** The profile speaks to the player; a public page speaks about them. */
  own?: boolean
}

/** The glyph sits next to the handle, so it stays smaller than the card one. */
const GLYPH_SIZE = "3.5rem"

const { handle, nemesis, own = false } = Astro.props
const opponent = nemesis.opponent
const standing = opponent.standing
const total = played(nemesis)
// The score renders as an array of elements, which carries no text node between
// them, so the record reads as one number and not as three words. A paragraph
// takes no accessible name, so the spoken form needs a role that does.
const record = `${nemesis.wins} ${nemesis.wins === 1 ? "win" : "wins"}, ${nemesis.losses} ${nemesis.losses === 1 ? "loss" : "losses"}`
---

<Prompt
  command={own ? "cat ~/.nemesis" : `cat /players/${handle}/nemesis`}
  comment={
    own
      ? `beat you ${nemesis.losses} ${nemesis.losses === 1 ? "time" : "times"}`
      : undefined
  }
/>
<Panel tone="alert" class="mt-4">
  <h2 class="m-0 text-sm font-normal tracking-wider text-alert">nemesis</h2>
  <div
    class="mt-3 flex flex-wrap items-center justify-between gap-4"
    data-nemesis={opponent.handle}
  >
    <div class="flex items-center gap-3">
      <Glyph glyph={opponent.glyph} size={GLYPH_SIZE} framed class="shrink-0" />
      <div class="min-w-0">
        <PlayerLink player={opponent} class="text-base tracking-wider" />
        <div class="mt-1 flex flex-wrap items-baseline gap-2 text-2xs text-dim">
          <RankMark rank={standing.rank} labelled />
          <span class="tabular-nums">#{standing.place}</span>
        </div>
      </div>
    </div>
    <div class="text-right">
      <p
        class="m-0 text-[1.75rem] leading-none font-bold tabular-nums"
        role="img"
        aria-label={record}
      >
        {[
          <span class="text-ink">{nemesis.wins}</span>,
          <span class="text-mute">-</span>,
          <span class="text-alert">{nemesis.losses}</span>,
        ]}
      </p>
      <p class="m-0 mt-1 text-2xs text-dim tabular-nums">
        {nemesis.losses} of {total} matches lost
      </p>
    </div>
  </div>
</Panel>
