---
import { actions } from "astro:actions"
import type { Player, Tournament } from "../lib/api"
import { formatDate } from "../lib/dates"
import { STATUS_LABEL, isRegistrationOpen, toLocalInput } from "../lib/tournaments"
import Badge from "./ui/Badge.astro"
import Button from "./ui/Button.astro"
import Countdown from "./ui/Countdown.astro"
import Glyph from "./ui/Glyph.astro"
import Kv from "./ui/Kv.astro"
import Panel from "./ui/Panel.astro"

interface Props {
  tournament: Tournament
  /** The viewer, when logged in. Decides between apply, retire and login. */
  me?: Player
  /** Whether the viewer is already an entrant. */
  registered?: boolean
}

const { tournament: t, me, registered = false } = Astro.props
const canRegister = isRegistrationOpen(t)
const concluded = t.status === "concluded"
const badge = concluded ? "CONCLUDED" : t.status === "open" && !canRegister ? "REGISTRATION CLOSED" : STATUS_LABEL[t.status]
const badgeTone = canRegister ? "accent" : t.status === "live" ? "warn" : "muted"
const winner = t.winner?.player
---

<article data-tournament={t.id}>
<Panel tone={canRegister ? "accent" : "default"}>
  <div class="flex flex-wrap items-start justify-between gap-2">
    <h3 class="m-0 text-sm tracking-wide text-bright">{t.game}: {t.name}</h3>
    <Badge tone={badgeTone} filled={canRegister}>{badge}</Badge>
  </div>
  {t.description && <p class="mt-1 text-xs text-dim">{t.description}</p>}

  <div class="mt-3 flex flex-col gap-1">
    <Kv label="Mode">{t.mode}</Kv>
    <Kv label="Date" tone={canRegister ? "accent" : "default"}>{formatDate(new Date(`${t.date}T00:00:00`))}</Kv>
    <Kv label="Entrants">{t.entrantCount}</Kv>
    {
      t.status === "open" && (
        <Kv label="Open until">
          <time datetime={t.registrationClosesAt} data-local>{toLocalInput(t.registrationClosesAt).replace("T", " ")}</time>
        </Kv>
      )
    }
  </div>

  {
    canRegister && (
      <div class="mt-4 flex flex-wrap items-center gap-4">
        {me ? (
          registered ? (
            <form method="POST" action={actions.retireFromTournament}>
              <input type="hidden" name="id" value={t.id} />
              <Button variant="danger">RETIRE</Button>
            </form>
          ) : (
            <form method="POST" action={actions.applyToTournament}>
              <input type="hidden" name="id" value={t.id} />
              <Button>APPLY</Button>
            </form>
          )
        ) : (
          <Button href="/login" variant="ghost">LOGIN TO APPLY</Button>
        )}
        {registered && <span class="text-2xs text-accent">you are in.</span>}
        <Countdown deadline={t.registrationClosesAt} />
      </div>
    )
  }

  {
    t.hasBracket && (
      <div class="mt-4">
        <Button href={`/tournaments/${t.id}/bracket`} variant={concluded ? "ghost" : "primary"}>
          {concluded ? "BRACKET" : "LIVE BRACKET"}
        </Button>
      </div>
    )
  }

  {
    concluded && (
      <div class="mt-5 flex flex-wrap items-center gap-5 border-t border-faint pt-4">
        {winner ? (
          <>
            <Glyph glyph={winner.glyph} size="5rem" framed />
            <div>
              <div class="text-2xs tracking-wider text-dim">winner</div>
              <a
                href={`/players/${winner.handle}`}
                class="mt-1 block text-[1.375rem] leading-tight tracking-wider text-accent no-underline hover:text-bright"
              >
                {winner.handle}
              </a>
              <div class="mt-1 text-2xs tracking-wider text-dim">
                rank: <span class="text-accent">champion</span>
              </div>
            </div>
          </>
        ) : (
          <p class="m-0 text-2xs text-mute">{t.winner ? "the winner deleted their account." : "no winner recorded."}</p>
        )}
      </div>
    )
  }
</Panel>
</article>

<script>
  // The server cannot know the viewer's timezone, so the deadline is written
  // again here in local time.
  for (const el of document.querySelectorAll<HTMLTimeElement>("time[data-local]")) {
    const at = new Date(el.dateTime)
    el.textContent = at.toLocaleString(undefined, { dateStyle: "medium", timeStyle: "short" })
  }
</script>
