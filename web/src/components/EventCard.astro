---
import type { CollectionEntry } from "astro:content"
import { formatEurDate } from "../lib/dates"
import DuotoneImage from "./DuotoneImage.astro"
import Badge from "./ui/Badge.astro"
import Kv from "./ui/Kv.astro"
import Panel from "./ui/Panel.astro"

interface Props {
  event: CollectionEntry<"events">
}

const { event } = Astro.props
const status = event.data.status

const look: Record<
  typeof status,
  { panel: "accent" | "warn" | "default"; badge: "accent" | "warn" | "muted"; label: string }
> = {
  OPEN: { panel: "accent", badge: "accent", label: "REGISTRATION OPEN" },
  SOON: { panel: "warn", badge: "warn", label: "ANNOUNCED" },
  CLOSED: { panel: "default", badge: "muted", label: "ARCHIVED" },
}
---

<Panel tone={look[status].panel}>
  {
    event.data.image && (
      <Fragment slot="media">
        <DuotoneImage src={event.data.image} alt={event.data.name} />
      </Fragment>
    )
  }
  <div class="flex flex-wrap items-start justify-between gap-2">
    <h3 class="m-0 text-sm tracking-wide text-bright">{event.data.name}</h3>
    <Badge tone={look[status].badge} filled={status === "OPEN"}>{look[status].label}</Badge>
  </div>
  <div class="mt-3 flex flex-col gap-1">
    <Kv label="Date" tone={status === "OPEN" ? "accent" : "default"}>
      {formatEurDate(event.data.date)}
    </Kv>
    <Kv label="Games">{event.data.games}</Kv>
  </div>
</Panel>
