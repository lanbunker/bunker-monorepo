---
import type { Event } from "../lib/api"
import { coverOf } from "../lib/event-images"
import { phaseBadge, phaseOf } from "../lib/events"
import DuotoneImage from "./DuotoneImage.astro"
import Badge from "./ui/Badge.astro"
import Kv from "./ui/Kv.astro"
import LocalTime from "./ui/LocalTime.astro"
import Panel from "./ui/Panel.astro"

interface Props {
  event: Event
}

const { event } = Astro.props
const phase = phaseOf(event)
const badge = phaseBadge(phase)
const cover = coverOf(event.image)
const live = phase === "live"
---

<article data-event={event.id}>
  <Panel tone={live ? "warn" : phase === "upcoming" ? "accent" : "default"}>
    {cover && (
      <Fragment slot="media">
        <DuotoneImage src={cover} alt={event.name} />
      </Fragment>
    )}
    <div class="flex flex-wrap items-start justify-between gap-2">
      <h3 class="m-0 text-sm tracking-wide text-bright">
        {event.name}
        {event.location && <span class="text-dim"> {event.location}</span>}
      </h3>
      <Badge tone={badge.tone} filled={badge.filled}>
        {badge.label}
      </Badge>
    </div>
    {event.description && <p class="mt-1 text-xs text-dim">{event.description}</p>}
    <div class="mt-3 flex flex-col gap-1">
      <Kv label="Date" tone={phase === "past" ? "default" : "accent"}>
        <LocalTime at={event.startsAt} mode="date" />
      </Kv>
      <Kv label="Doors">
        <LocalTime at={event.startsAt} mode="time" />
        <span class="text-dim"> to </span>
        <LocalTime at={event.endsAt} mode="time" />
      </Kv>
      {event.games && <Kv label="Games">{event.games}</Kv>}
      {(phase === "past" || live) && (
        <Kv label="Checked in">
          <span data-checkins>{event.checkinCount}</span>
          {event.checkinCount === 1 ? " player" : " players"}
        </Kv>
      )}
    </div>
    {live && (
      <p class="m-0 mt-4 text-2xs text-warn">
        doors are open. scan the QR code at the entrance to check in.
      </p>
    )}
  </Panel>
</article>
