---
import type { Player } from "../lib/api"
import { RANKS, formatCycles, isPodium } from "../lib/cycles"
import { formatDate } from "../lib/dates"
import Badge from "./ui/Badge.astro"
import Glyph from "./ui/Glyph.astro"
import Kv from "./ui/Kv.astro"
import Panel from "./ui/Panel.astro"
import RankMark from "./ui/RankMark.astro"

interface Props {
  player: Player
  /** Set on the profile page, so the card says it is you. */
  own?: boolean
}

/** The glyph and the badge under it share one width, so the rank stays centred. */
const GLYPH_SIZE = "7.5rem"

const { player, own = false } = Astro.props
const standing = player.standing
const rank = RANKS[standing.rank]
// The rank cells are decoration, so the name under them is the one thing a
// screen reader reads for the rank.
---

<Panel player={player.glyph.color}>
  <div class="flex flex-wrap gap-6">
    <div class="flex shrink-0 flex-col items-center gap-3" style={`width:${GLYPH_SIZE}`}>
      <Glyph glyph={player.glyph} size={GLYPH_SIZE} framed />
      <div class="flex flex-col items-center gap-1">
        <RankMark rank={standing.rank} size="xl" decorative />
        <span
          class:list={[
            "text-[1.5rem] leading-none font-bold tracking-[0.1em]",
            rank.text,
          ]}
        >
          {rank.label}
        </span>
      </div>
    </div>
    <div class="min-w-[16rem] flex-1">
      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <h1
          class="handle m-0 text-[1.75rem] leading-none text-(--player)"
          title={player.handle}
        >
          {player.handle}
        </h1>
        <span
          class:list={[
            "text-xs tracking-wider tabular-nums",
            isPodium(standing) ? "font-bold text-accent" : "text-dim",
          ]}
          data-place={standing.place}
        >
          #{standing.place} <span class="text-mute">of {standing.players}</span>
        </span>
        <div class="flex items-center gap-2">
          {player.role === "admin" && <Badge tone="warn">admin</Badge>}
          {own && (
            <Badge tone="accent" filled>
              you
            </Badge>
          )}
        </div>
      </div>
      <div class="mt-5 flex flex-col gap-1">
        <Kv label="Cycles" tone="accent">
          <span class="text-base font-bold tabular-nums" data-cycles>
            {formatCycles(standing.cycles)}
          </span>
        </Kv>
        <Kv label="Enlisted">{formatDate(new Date(player.createdAt))}</Kv>
        <Kv label="Glyph">
          <span class="text-dim">bits</span>{" "}
          <span data-glyph-bits>{player.glyph.bits}</span>
          <span class="ml-2 text-dim">color</span> {player.glyph.color}
        </Kv>
      </div>
    </div>
  </div>
</Panel>
