---
import type { Player } from "../lib/api"
import { formatDate } from "../lib/dates"
import Badge from "./ui/Badge.astro"
import Glyph from "./ui/Glyph.astro"
import Kv from "./ui/Kv.astro"
import Panel from "./ui/Panel.astro"

interface Props {
  player: Player
  /** Set on the profile page, so the card says it is you. */
  own?: boolean
}

const { player, own = false } = Astro.props
---

<Panel tone={own ? "accent" : "default"}>
  <div class="flex flex-wrap gap-6" style={`--player:${player.glyph.color}`}>
    <Glyph glyph={player.glyph} size="7.5rem" framed />
    <div class="min-w-[16rem] flex-1">
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="m-0 text-[1.75rem] leading-none text-(--player)">{player.handle}</h1>
        <div class="flex items-center gap-2">
          {player.role === "admin" && <Badge tone="warn">admin</Badge>}
          {own && <Badge tone="accent" filled>you</Badge>}
        </div>
      </div>
      <div class="mt-5 flex flex-col gap-1">
        <Kv label="Enlisted">{formatDate(new Date(player.createdAt))}</Kv>
        <Kv label="Glyph">
          <span class="text-dim">bits</span> {player.glyph.bits}
          <span class="ml-2 text-dim">color</span> {player.glyph.color}
        </Kv>
      </div>
    </div>
  </div>
</Panel>
