---
import type { Rank } from "../../lib/api"
import { RANKS, RANK_CELLS } from "../../lib/cycles"

type Size = "sm" | "lg" | "xl"

interface Props {
  rank: Rank
  /** Also print the rank name after the cells. */
  labelled?: boolean
  /** The rank is named next to the mark already, so the mark says nothing. */
  decorative?: boolean
  size?: Size
  class?: string
}

const {
  rank,
  labelled = false,
  decorative = false,
  size = "sm",
  class: className,
} = Astro.props
const info = RANKS[rank]
const won = "▮".repeat(info.tier)
const left = "▯".repeat(RANK_CELLS - info.tier)

const sizeClass: Record<Size, string> = {
  sm: "gap-2 text-2xs tracking-[0.15em]",
  lg: "gap-3 text-sm tracking-[0.2em]",
  xl: "gap-3 text-base tracking-[0.25em]",
}
---

<span
  class:list={[
    "inline-flex items-center whitespace-nowrap",
    sizeClass[size],
    info.text,
    className,
  ]}
  title={`rank ${info.label}`}
  data-rank={rank}
>
  <!-- A phone shows the name only. The cells repeat what the name says. The
       cells still to earn stay grey, so the ones won read as won at every rank. -->
  <span aria-hidden="true" class:list={[labelled && "max-[40rem]:hidden"]}>
    {[<span>{won}</span>, <span class="text-mute">{left}</span>]}
  </span>
  {labelled && <span class="font-bold">[{info.label}]</span>}
  {!labelled && !decorative && <span class="sr-only">{info.label}</span>}
</span>
