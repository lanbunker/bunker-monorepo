---
/**
 * An instant in the viewer's own zone. The server cannot know that zone, so it
 * renders the UTC value and a script writes it again in local time.
 */
type Mode = "datetime" | "time" | "date"

interface Props {
  at: string
  mode?: Mode
  class?: string
}

const { at, mode = "datetime", class: className } = Astro.props
---

<time datetime={at} data-local={mode} class={className}>
  {at.replace("T", " ").slice(0, 16)} UTC
</time>

<script>
  const modes = {
    datetime: { dateStyle: "medium", timeStyle: "short" },
    time: { timeStyle: "short" },
    date: { dateStyle: "medium" },
  } as const

  for (const el of document.querySelectorAll<HTMLTimeElement>("time[data-local]")) {
    const mode = el.dataset.local
    const options =
      mode === "time" || mode === "date" || mode === "datetime"
        ? modes[mode]
        : modes.datetime
    el.textContent = new Date(el.dateTime).toLocaleString(undefined, options)
  }
</script>
