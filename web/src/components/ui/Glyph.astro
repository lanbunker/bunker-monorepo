---
import { GlyphMark } from "../GlyphMark"
import type { Glyph } from "../../lib/api"

interface Props {
  glyph: Glyph
  /** CSS size such as "1em" or "7.5rem". Width and height are equal. */
  size?: string
  framed?: boolean
  class?: string
}

// The mark is drawn one time, in React, so the islands and the pages agree.
// Without a client directive this renders to static markup and ships no script.
const { glyph, size = "1em", framed = false, class: className } = Astro.props
---

<GlyphMark glyph={glyph} size={size} framed={framed} className={className} />
