---
interface Props {
  deadline: string
  label?: string
}

const { deadline, label = "T-" } = Astro.props
---

<div
  class="countdown inline-flex items-center gap-1 text-xs tracking-wider text-accent tabular-nums"
  data-deadline={deadline}
  role="timer"
>
  <span class="mr-1 text-2xs text-dim">{label}</span>
  <span class="cd-segment" data-unit="d"></span>
  <span class="text-dim" aria-hidden="true">
    :
  </span>
  <span class="cd-segment" data-unit="h"></span>
  <span class="text-dim" aria-hidden="true">
    :
  </span>
  <span class="cd-segment" data-unit="m"></span>
  <span class="text-dim" aria-hidden="true">
    :
  </span>
  <span class="cd-segment" data-unit="s"></span>
</div>

<style>
  .cd-segment {
    min-width: 1.8rem;
    padding: 0.15rem 0.35rem;
    text-align: center;
    background: rgba(0, 255, 65, 0.08);
    border: 1px solid rgba(0, 255, 65, 0.25);
  }

  .countdown.expired {
    color: var(--color-alert);
  }

  .countdown.expired .cd-segment {
    background: rgba(255, 59, 59, 0.06);
    border-color: rgba(255, 59, 59, 0.3);
  }
</style>

<script>
  const pad2 = (n: number) => String(n).padStart(2, "0")

  const tick = () => {
    for (const el of document.querySelectorAll<HTMLElement>(".countdown")) {
      const deadline = el.dataset.deadline
      if (!deadline) continue

      const remaining = new Date(deadline).getTime() - Date.now()
      const totalSec = Math.max(0, Math.floor(remaining / 1000))
      const parts = {
        d: Math.floor(totalSec / 86400),
        h: Math.floor((totalSec % 86400) / 3600),
        m: Math.floor((totalSec % 3600) / 60),
        s: totalSec % 60,
      }

      el.classList.toggle("expired", remaining <= 0)
      el.setAttribute(
        "aria-label",
        remaining <= 0
          ? "Registration closed"
          : `${parts.d} days ${parts.h} hours ${parts.m} minutes remaining`,
      )
      for (const seg of el.querySelectorAll<HTMLElement>(".cd-segment")) {
        const unit = seg.dataset.unit
        if (unit === "d" || unit === "h" || unit === "m" || unit === "s") {
          seg.textContent = pad2(parts[unit])
        }
      }
    }
  }

  tick()
  setInterval(tick, 1000)
</script>
