---
type Tone = "default" | "accent" | "warn" | "alert"

interface Props {
  label: string
  tone?: Tone
}

const { label, tone = "default" } = Astro.props

const valueClass: Record<Tone, string> = {
  default: "text-ink",
  accent: "text-accent",
  warn: "text-warn",
  alert: "text-alert",
}
---

<!-- On a phone the value drops under the label, so a long value wraps as a
     left-aligned line instead of a ragged right-aligned block. -->
<div class="flex items-baseline gap-2 text-xs max-[30rem]:flex-col max-[30rem]:items-start max-[30rem]:gap-0">
  <span class="shrink-0 text-dim tracking-wide lowercase">{label}</span>
  <span class="leader max-[30rem]:hidden" aria-hidden="true"></span>
  <span
    class:list={[
      "max-w-[65%] text-right max-[30rem]:max-w-full max-[30rem]:text-left",
      valueClass[tone],
    ]}
  >
    <slot />
  </span>
</div>
