---
import { listPath } from "../../lib/paging"
import Button from "./Button.astro"

interface Props {
  page: number
  totalPages: number
  total: number
  /** The path the page links point at. The `page` query parameter is added. */
  href: string
  /** The search the pages are of, so a page link keeps it. */
  q?: string | undefined
  /** Singular noun for the count, such as "player". */
  noun: string
  /** The plural, when adding an `s` does not make it. */
  plural?: string
}

const { page, totalPages, total, href, q, noun, plural = `${noun}s` } = Astro.props
const link = (to: number) => listPath(href, q, to)
---

{totalPages > 1 && (
  <nav
    aria-label="Pages"
    class="mt-4 flex flex-wrap items-center justify-between gap-3 text-2xs text-dim"
  >
    <span>
      page <span class="text-ink">{page}</span> of{" "}
      <span class="text-ink">{totalPages}</span>
      <span class="ml-2">{`${total} ${total === 1 ? noun : plural}`}</span>
    </span>
    <div class="flex items-center gap-2">
      <Button href={link(page - 1)} variant="ghost" size="sm" disabled={page <= 1}>
        ← PREV
      </Button>
      <Button
        href={link(page + 1)}
        variant="ghost"
        size="sm"
        disabled={page >= totalPages}
      >
        NEXT →
      </Button>
    </div>
  </nav>
)}
