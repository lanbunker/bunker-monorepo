{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "lanbunker",
    "compatibility_date": "2026-04-14",
    "compatibility_flags": ["nodejs_compat"],
    "observability": {
        "enabled": true,
    },
    // Where the Rust API answers. The Worker is the only client of this name.
    // The deploy uses the top level. Local runs select an environment with
    // CLOUDFLARE_ENV, because a Worker var wins over the shell in local mode.
    "vars": {
        "API_URL": "https://api.lanbunker.eu",
    },

    "env": {
        "dev": {
            "vars": { "API_URL": "http://127.0.0.1:3000" },
        },
        "e2e": {
            "vars": { "API_URL": "http://127.0.0.1:3999" },
        },
    },

    // Uncomment when ready for D1
    // "d1_databases": [
    //   {
    //     "binding": "DB",
    //     "database_name": "lanbunker-db",
    //     "database_id": "<your-database-id>"
    //   }
    // ]
}
