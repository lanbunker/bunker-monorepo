{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "lanbunker",
    "compatibility_date": "2026-04-14",
    "compatibility_flags": ["nodejs_compat"],
    "observability": {
        "enabled": true,
    },
    // Where the Rust API answers. The Worker is the only client of this name.
    // Local development reads API_URL from `.env` or the shell instead.
    "vars": {
        "API_URL": "https://api.lanbunker.eu",
    },

    // Uncomment when ready for D1
    // "d1_databases": [
    //   {
    //     "binding": "DB",
    //     "database_name": "lanbunker-db",
    //     "database_id": "<your-database-id>"
    //   }
    // ]
}
