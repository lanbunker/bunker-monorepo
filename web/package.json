{
    "name": "lanbunker-website",
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "CLOUDFLARE_ENV=dev astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "astro": "astro",
        "typecheck": "node node_modules/tsgo/bin/tsc --noEmit",
        "check": "astro check",
        "lint": "oxlint src e2e playwright.config.ts",
        "fmt": "oxfmt && prettier --write --log-level warn \"src/**/*.astro\"",
        "fmt:check": "oxfmt --check && prettier --check --log-level warn \"src/**/*.astro\"",
        "e2e": "playwright test",
        "optimize:imgs": "node scripts/optimize-imgs.mjs"
    },
    "dependencies": {
        "@astrojs/cloudflare": "^14.3.1",
        "@astrojs/react": "^6.0.5",
        "@tailwindcss/vite": "^4.3.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "astro": "^7.3.2",
        "openapi-fetch": "^0.17.0",
        "photoswipe": "^5.4.4",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "tailwindcss": "^4.3.3",
        "ts-pattern": "^5.9.0",
        "wrangler": "^4.125.0",
        "zod": "^4.6.2"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.10",
        "@playwright/test": "^1.63.0",
        "@types/node": "^22.20.2",
        "openapi-typescript": "^7.13.0",
        "oxfmt": "^0.67.0",
        "oxlint": "^1.82.0",
        "prettier": "^3.9.6",
        "prettier-plugin-astro": "^1.0.0",
        "sharp": "^0.35.4",
        "tsgo": "npm:typescript@^7.0.2",
        "typescript": "^6.0.3",
        "vite": "^8.3.0"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "packageManager": "pnpm@10.32.1"
}
